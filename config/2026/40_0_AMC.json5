{
  AMC_NAME: "Union Mutual Fund",
  CLONEKEYS: {
    benchmark_index: ".*benchmark_index",
    scheme_launch_date: ".*date_of_allotment",
    "monthly_aaum":".*aaum_as_on$",
    fund_manager:".*t_?o_?t_?a_?l_e_?x_?p_?e_?r_?i_?e_?n_?c_?e",
    min_amt:".*lump_?sum",
    
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  IMP_DATA: {
    amc_name: "Union Asset Management Company Private Limited",
    mutual_fund_name: "Union Mutual Fund",
  },
  MAIN_MAP: {
    map: true,
    select: true,
    special: true,
  },
  MERGEKEYS: {
    load: [".*(exit_?load|entry_?load)"],
    metrics: [".*(major_risk_factor|key_statistics|expense_ratio)", ],
  },
  PARAMS: {
    clip_bbox: [
      [0, 110, 165, 850],
      [420, 110, 575, 850]
    ],
    content_size: [30, 12],
    data: {
      color: [696969],
      font: ["Swiss721BT-Bold"],
      size: [6, 11],
      update_size: 30,
    },
    line_side: "",
    line_x: 180,
    max_financial_index_highlight: 6,
    method: "clip",
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    title: {
      bbox: [0, 0, 575, 60],
      ocr: false,
      pattern: "(Union.+?Fund)",
    },
    update_min_add: false,
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy).*": ["_extract_scheme_data", "scheme"],
  },
  PRE_DATA_SELECT: [],
  PROMOTE_KEYS: {},
  REGEX: {
    aum: "([\\d,.]+\\s*crore)",
    min_amt:"([\\d,]+).*? (?:Re.)?\\s*([\\d,]+)",
    manager: {
      name: "(?:Mrs?|Ms)\\.?\\s+([A-Za-z\\s]+\\s+[A-Za-z]+)",
      exp: "(\\d{1,2}\\+?\\s+[Yy]ears?)",
      since: "[A-Za-z]+\\s*\\d{1,2}\\,\\s+\\d{4}",
    },
     metrics: "(Equity Turnover|Average\\s*Maturity|Macaulay\\s*Duration|Tracking Error\\s*(?:Regular)?|Modified\\s*Duration|YTM\\D*|Yield\\s*[Tt]o\\s*Maturity|Portfolio\\s*Turnover\\s*Ratio\\D+|Standard\\s*Deviation|Beta|Sharpe\\s*Ratio|Tracking\\s*Error\\s*Direct|Information\\s*Ratio)\\s*[\\:\\-]?\\s*(\\(?\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?\\s*\\)?\\s*[\\:\\-]?\\s*-?\\d+\\.?\\d+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?)",
    
    scheme: [
      "Fund\\s+Details?",
      "Date\\s*[Oo]f\\s*[aA]llotment",
      "Benchmark\\s*Index",
      "NAV\\s+[Aa]s\\s+[Oo]n",
      "AUM\\s*as\\s*on",
      "AAUM\\s*as\\s*on",
      "Fund\\s+Manager",
      "T\\s*o\\s*t\\s*a\\s*l\\s+E\\s*x\\s*p\\s*e\\s*r\\s*i\\s*e\\s*n\\s*c\\s*e",
      "Minimum\\s+[iI]nvestment",
      "Lump\\s*sum\\s*[aA]mount",
      "(Systematic\\s+[iI]nvestment\\s+[pP]lan|SIP)\\s+[Aa]mount",
      "Load\\s+Structure",
      "Exit\\s+Load",
      "(?:Base)?\\s*Expense\\s+Ratio",
      "Market\\s+Cap\\s*as",
      "EOL",
      "Major\\s+Risk\\s+[fF]actors?",
      "EOL",
    ],
      escape: "[^A-Za-z0-9\\s\\-\\(\\).,\\+\\%\\:\\&]+|\\(?TRI\\)?|Total\\s*Returns?\\s*Index",
 
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(lump_?sum)": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*(major_risk_factors?|expense_ratio)$": [
      "_extract_generic_data",
      "metrics",
    ],
     ".*aaum_as_on": ["_extract_generic_data", "aum"],


  },
  SELECTKEYS: [
    "benchmark_index",
    "scheme_launch_date",
    "monthly_aaum",
    "load",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "mutual_fund_name",
    "fund_manager",
    "page_number",
    "min_amt",
    "min_addl_amt"
  ],
  SPECIAL_FUNCTIONS: {
    fund_manager:"_update_manager_data"
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  Z_MUTUAL_FUND_DATA: {},
}
