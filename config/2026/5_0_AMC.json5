{
  AMC_NAME: "Bank Of India Mutual Fund",
  DUPLICATE_MUTUAL_FUNDS: {},
  IMP_DATA: {
    amc_name: "Bank of India Investment Managers Private Limited",
    mutual_fund_name: "Bank of India Mutual Fund",
  },
  MAIN_MAP: {
    map: true,
    select: true,
    special: true,
  },
  PARAMS: {
    clip_bbox: [
      [0, 110, 145, 810],
      [430, 210, 590, 780],
    ],
    content_size: [30, 10],
    data: {
      color: [6969],
      font: ["Calibri-Bold"],
      size: [6, 9],
      update_size: 30,
    },
    line_side: "both",
    line_x: 290,
    max_financial_index_highlight: 7,
    method: "line",
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    title: {
      bbox: [0, 0, 590, 65],
      ocr: false,
      pattern: "(Bank\\s+[Oo]f\\s+India.*?(?:Plan|Funds?|ETF|FOF|FTF|Saver)\\s*(?:of Funds?|FO?o?F)?)",
    },
    update_min_add: false,
  },

  REGEX: {
    aum: "([\\d,.]+\\s*[Cc]rores?)",
    date:"\\d{1,2}(?:th|st|rd|nd)?\\s+(?:Janu|Feb|Mar|Apr|Ma|Jun|Jul|Augu|Sept|Oct|Nove|Dec)?[a-z\\,\\s]+\\d{4}",
    benchmark:"(?:Janu|Feb|Mar|Apr|Ma|Jun|Jul|Augu|Sept|Oct|Nove|Dec)?[a-z\\,\\s]+\\d{4}\\s+(.+)$",
    min_amt: "([\\d,]+).*?([\\d,]+)",
    scheme: [
      "Fund\\s+Details?",
      "NAV.+?[Aa]s\\s+[Oo]n",
      "AUM\\s*\\:?(?:as\\s*on)?",
      "AAUM\\s*\\:?(?:as\\s*on)?",
      "Fund\\s+Manager\\s+[Dd]etails",
      "Minimum\\s+[iI]nvestment",
      "Lump\\s+[Ss]um\\s+(?:[Aa]mount)?",
      "Additional\\s+[Pp]urchase\\s+[aA]mount|(Systematic\\s+[iI]nvestment\\s+[pP]lan|SIP)\\s+(?:Amount)?",
      "Load\\s+Structure",
      "Exit\\s+Load",
      "(?:Base)?\\s*Expense\\s+Ratio",
      "EOL",
      "Benchmark\\s+[rR]iskometer",
      "EOL",
    ],
    metrics: "(R2|Equity\\s+Turnover|Gross\\s+(?:Exposure)?\\s+Turnover|Average\\s*Maturity\\D*|Macaulay\\s*Duration\\D*|Tracking Error\\s*(?:Regular)?|Modified\\s*Duration\\D*|YTM\\D*|Yield\\s*[Tt]o\\s*Maturity|Portfolio\\s*Turnover\\s*Ratio|Standard\\s*Deviation|Beta|Sharpe\\s*Ratio|Tracking\\s*Error\\s*Direct|Information\\s*Ratio\\D*)\\s*[\\:\\-]?\\s*(\\(?\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?\\s*\\)?\\s*[\\:\\-]?\\s*-?\\d+\\.?\\d+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?)",
    manager: {
      name: "(?:Mr.?|Mrs.?|Ms.?)\\s+([A-Za-z]+\\s*[A-Za-z]+)",
      exp: "(\\d+.?\\d*\\+?\\s*[Yy]ears?)",
      since: "((?:Jan|Feb|Mar|Apri|Jun|Jul|Aug|Sept|Oct|Nove|Dece)[a-z]+\\s+\\d{1,2}\\s*,?.*?\\d{4})",
    },
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:]+|Allotment|\\(?TRI\\)?|Total\\s*Returns?\\s*Index|Benchmark\\s+[Ii]ndex",
  },
  PATTERN_TO_FUNCTION: {
    "(before|dummy|DUMMY).*": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(lump_?sum|sip)": ["_extract_amt_data", "min_amt"],
    ".*(major_risk_factors|expense_ratio|benchmark_riskometer)": [
      "_extract_generic_data",
      "metrics",
    ],
    ".*aaum": ["_extract_generic_data", "aum"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "benchmark_index",
    "scheme_launch_date",
    "monthly_aaum",
    "load",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "mutual_fund_name",
    "fund_manager",
    "page_number",
    "min_amt",
    "min_addl_amt",
  ],
  MERGEKEYS: {
    load: [".*(exit_?load|entry_?load)"],
    metrics: [".*(major_risk_factor|benchmark_riskometer|expense_ratio)"],
  },
  CLONEKEYS: {
    benchmark_index: ".*fund_details",
    scheme_launch_date: ".*fund_details",
    monthly_aaum: ".*aaum",
    fund_manager: "before.fund_manager",
    min_amt: ".*lump_?sum(?:_amount)?",
    min_addl_amt: ".*sip(?:_amount)?",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {
    fund_manager: "_update_manager_data",
     scheme_launch_date: "_update_date_data",
    benchmark_index: "_update_benchmark_data",
  },
  Z_MUTUAL_FUND_DATA: {},
}
