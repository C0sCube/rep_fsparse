{
  AMC_NAME: "Lakshya Asset Management Pvt Ltd.",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Lakshya Asset Management Pvt Ltd.",
    mutual_fund_name: "Lakshya Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(?:LAKSHYA|Lakshya).+?(?:FUND|Fund)",
      bbox: [0, 0, 400, 110],
    },
    clip_bbox: [
      [0, 110, 575, 185],
      [0, 235, 300, 625],
      [295, 235, 580, 600],
    ],
    line_x: 200.0,
    data: {
      size: [3, 9],
      color: [23],
      update_size: 30.0,
      font: ["Ubuntu-Bold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 4,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "^.+([\\d,.]+)$",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      "Direct Growth NAV",
      "Monthly\\s+Average\\s+AUM",
      "EOL",
      "Scheme\\s+Details?",
      "Allotment\\s+[dD]ate",
      "Fund\\s+[mM]anager",
      "Benchmark",
      "Initial\\s+[pP]urchase",
      "Additional",
      "Exit\\s+[Ll]oad",
      "Product\\s+[sS]uitability",
      "EOL",
      "Maturity\\s+[Aa]nd\\s+[Yy]ield",
      "EOL",
    ],
    min_amt: "([\\d,]+).*?(\\d+|any)",
    offset_metrics: {
      key: "(Tracking Error|Modified Duration|Macaulay Duration|Yield to [Mm]aturity|Average Maturity)",
      value: "(\\d+\\.\\d+(?:%|[Da]ays?|[Mm]onths?|[Yy]ears?)?)",
    },
    manager: {
      pattern: "([A-Za-z]+\\s+[A-Za-z]+)\\s+\\(?Managing.+?[sS]ince(.+?)\\)?\\s+Total\\s+Experience\\D+?(\\d{1,2}\\s+[Yy]ears?)",
      fields: ["name", "since", "exp"],
    },
    metric: "(Aggregate|Beta|R\\s*Squared|Standard Deviation|Sharpe\\*?|Modif?\\s*i?ed\\s*[dD]uration|(?:Average|Residual)\\s+[mM]aturity\\D*|YTM|Macaulay\\s+[dD]uration|Y?ield\\s+[Tt]o\\s+Maturity|Information Ratio|Tracking\\s*Error.+?)\\s*\\:?\\s*(-?[\\d.]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?|NA|Nil)",
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\:]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(initial_purchase|additional)": ["_extract_amt_data", "min_amt"],
    ".*and_yield": ["_extract_generic_data", "metric"],
    ".*average_aum": ["_extract_generic_data", "aum"],
    ".*fund_manager": ["_extract_manager_data", "manager"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "benchmark_index",
    "scheme_launch_date",
    "monthly_aaum",
    "load",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "mutual_fund_name",
    "fund_manager",
    "page_number",
    "min_amt",
    "min_addl_amt"
  ],
  MERGEKEYS: {
    load: [".*(exit_?load|entry_?load)"],
    metrics: [".*(and_yield|scheme_?portfolio)", ],
  },
  CLONEKEYS: {
    benchmark_index: ".*benchmark$",
    scheme_launch_date: ".*allotment_date$",
    "monthly_aaum":".*average_aum$",
    fund_manager:".*fund_manager",
    min_amt:".*initial",
    min_addl_amt:".*additional"
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
