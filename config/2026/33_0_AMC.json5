{
  AMC_NAME: "Nippon India Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Nippon Life India Asset Management Limited",
    mutual_fund_name: "Nippon India Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "((?:Nippon India|CPSE).*)$",
      bbox: [0, 0, 500, 40],
    },
    clip_bbox: [
      [0, 0, 185, 810],
      [410, 75, 590, 810],
    ],
    line_x: 180.0,
    data: {
      size: [6, 12],
      color: [-1],
      update_size: 30.0,
      font: [
        "HelveticaNeueCondensed-C",
        "HelveticaNeueLTPro-BdCn",
        "HelveticaNeueLTStd-MdCn",
      ],
    },
    content_size: [30.0, 8.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 4,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    date: "(\\b\\d{1,2}\\s*(?:January|February|March|April|May|June|July|August|September|October|November|December)\\s*\\d{4}\\b)",
    benchmark:"\\d{1,2}\\s+(?:January|February|March|April|May|June|July|August|September|October|November|December)\\s+\\d{4}(.+$)",
    min_amt: "([\\d,]+).*?([\\d,]+)",
    aum: "([\\d,.]+\\s+Cr\\.?)",
    scheme: [
      "Fund\\s+Details?",
      "NAV\\s+[Aa]s\\s+[Oo]n",
      "AUM:?",
      "AAUM:?",
      "Name\\s*[Oo]f\\s*Fund\\s+Managers",
      "Minimum\\s+[iI]nvestment",
      "Lumpsum\\s*Amount",
      "(Systematic\\s+[iI]nvestment\\s+[pP]lan|SIP)\\s*(?:Amount)?",
      "Load\\s+Structure",
      "Exit\\s+Load",
      "(?:Base)?\\s*Expense\\s+Ratio",
      "EOL",
      "Major\\s+Risk\\s+[fF]actors?",
      "EOL",
    ],
   
    offset_metrics: {
      key: "(Tracking Error|Modified Duration|Macaulay Duration|Yield to [Mm]aturity|Average Maturity)",
      value: "(\\d+\\.\\d+(?:%|[Da]ays?|[Mm]onths?|[Yy]ears?)?)",
    },
     metrics: "(Equity Turnover|Average\\s*Maturity|Macaulay\\s*Duration|Tracking Error\\s*(?:Regular)?|Modified\\s*Duration|YTM\\D*|Yield\\s*[Tt]o\\s*Maturity|Portfolio\\s*Turnover\\s*Ratio|Standard\\s*Deviation|Beta|Sharpe\\s*Ratio|Tracking\\s*Error\\s*Direct|Information\\s*Ratio)\\s*[\\:\\-]?\\s*(\\(?\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?\\s*\\)?\\s*[\\:\\-]?\\s*-?\\d+\\.?\\d+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?)",
       manager: {
      name: "(?:Mrs?|Ms)\\.?\\s+([A-Za-z]+\\s+[A-Za-z]+)",
      exp: "(?<=\\s)\\d{1,2}(?=\\s)",
      since: "[A-Za-z]{3}\\s*\\d{1,2}\\,\\s+\\d{4}",
    },
    escape: "[^A-Za-z0-9\\s\\-\\(\\).,\\+\\%\\:\\&]+|Date\\s*[Oo]f\\s*Inception|Allotment|Benchmark\\s*Name|\\(?TRI\\)?|Total\\s*Returns?\\s*Index",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy).*": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(lumpsum|sip)": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*(major_risk_factors|expense_ratio)$": [
      "_extract_generic_data",
      "metrics",
    ],
     ".*aaum$": ["_extract_generic_data", "aum"],


  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "benchmark_index",
    "scheme_launch_date",
    "monthly_aaum",
    "load",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "mutual_fund_name",
    "fund_manager",
    "page_number",
    "min_amt",
    "min_addl_amt"
  ],
  MERGEKEYS: {
    load: [".*(exit_?load|entry_?load)"],
    metrics: [".*(major_risk_factor|key_statistics|expense_ratio)", ],
  
  },
    CLONEKEYS: {
    benchmark_index: ".*fund_details$",
    scheme_launch_date: ".*fund_details$",
    "monthly_aaum":".*aaum$",
    fund_manager:".*fund_manager",
    min_amt:".*lumpsum_amount$",
    min_addl_amt:".*sip_amount$"
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {
    // scheme_launch_date: "_update_date_data",
    // benchmark_index: "_update_benchmark_data",
    fund_manager:"_update_manager_data"
  },
  Z_MUTUAL_FUND_DATA: {},
}
