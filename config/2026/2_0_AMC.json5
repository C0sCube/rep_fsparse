{
  AMC_NAME: "Baroda Bnp Paribas Mutual Fund",
  CLONEKEYS: {
    "benchmark_index":".*tier_1_benchmark$",
    "min_amt":".*lumpsum"
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  IMP_DATA: {
    amc_name: "Baroda BNP Paribas Asset Management India Private Limited",
    mutual_fund_name: "Baroda BNP Paribas Mutual Fund",
  },
  MAIN_MAP: {
    map: true,
    select: true,
    special: true,
  },
  MERGEKEYS: {
    load: [".*(exit_?load|entry_?load)"],
    metrics: [".*(major_risk_factor|key_statistics|expense_ratio)", ],
  },
  PARAMS: {
    clip_bbox: [[0, 60, 185, 850],[450, 60, 590, 850]],
    content_size: [30, 8],
    data: {
      color: [-1],
      font: ["Unnamed-T3"],
      size: [9, 10],
      update_size: 30,
    },
    line_side: "left",
    line_x: 210,
    max_financial_index_highlight: 4,
    method: "clip",
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    title: {
      bbox: [0, 0, 460, 60],
      ocr: false,
      pattern: "(Baroda\\s*BNP.*?(?:[fF]und|Path|ETF|F[Oo]F|Index|Plan)\\s*(?:[fF]unds?|of\\s+[Ff]unds?|Fund of [Ff]unds?)?)",
    },
    update_min_add: false,
  },
  PATTERN_TO_FUNCTION: {
    "(before|dummy*)": ["_extract_scheme_non_esc_data", "scheme"],
  },
  PRE_DATA_SELECT: [],
  PROMOTE_KEYS: {},
  REGEX: {
    aum: "(\\d+\\,?\\d+\\.\\d+)",
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:\\&]+|\\(TRI\\)|TRI|Total\\s*Returns?\\s*Index|Benchmark|Date\\s*of\\s*[iI]nception|Allotment",
    load: "(?:Entry Load)?(.*?)Exit Load\\s*(.*)$",
    lumpsum: ".+Lumpsum investment(.+?)Minimum Additional Purchase Amount(.+?)$",
    manager: {
      fields: ["name", "exp", "since"],
      pattern: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s*([\\w\\s]+)\\s+(\\d+\\s*[Yy]ears?)\\s+(\\d{2}-[A-Za-z]{3}-\\d{2})",
    },
    metric: "(RoE\\D+|Average\\s*Maturity|Macaulay\\s*Duration|Tracking Error\\s*(?:Regular)?|Modified\\s*Duration|YTM\\D*|Portfolio\\s*Turnover\\s*Ratio|Standard\\s*Deviation|Beta|Sharpe\\s*Ratio|Tracking\\s*Error\\s*Direct)\\s*[\\:\\-]?\\s*(\\(?\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?\\s*\\)?\\s*[\\:\\-]?\\s*-?\\d+\\.?\\d*\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?)",
    min_amt: "([\\d,]+)[A-Za-z\\s\\.]+([\\d,]+)",
    scheme: [
      "Fund\\s+Details?",
      "Date\\s+[Oo]f\\s+[aA]llotment",
      "Tier\\s+1\\s+[Bb]enchmark",
      "NAV\\s+as\\s+on",
      "Monthly\\s+AUM",
      "Monthly\\s+AAUM",
      "Fund\\s+Manager",
      "Minimum\\s+[iI]nvestment",
      "Lumpsum\\s+Amount",
      "Systematic\\s+[iI]nvestment\\s+[pP]lan",
      "Load\\s+Structure",
      "Exit\\s+Load",
      "Expense\\s+Ratio",
      "EOL",
      "Major\\s+Risk\\s+[fF]actors?",
      "EOL",
    ],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(lumpsum_amount)": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*(major_risk_factors|expense_ratio)$": [
      "_extract_generic_data",
      "metric",
    ],
    ".*fund_manager": ["_extract_manager_data", "manager"],
     ".*monthly_aaum": ["_extract_generic_data", "aum"],
  },
  SELECTKEYS: [
    "benchmark_index",
    ".*(date_of_allotment|monthly_?aaum|fund_manager)",
    "load",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "mutual_fund_name",
    "page_number",
    "min_amt",
  ],
  SPECIAL_FUNCTIONS: {},
  TERTIARY_PATTERN_TO_FUNCTION: {},
  Z_MUTUAL_FUND_DATA: {},
}
