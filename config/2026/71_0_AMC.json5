{
  AMC_NAME: "Zerodha Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Zerodha Asset Management Private Limited",
    mutual_fund_name: "Zerodha Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(Zerodha.+?(?:Fund?s?|ETF?|Index|Path)\\s*(?:F[Oo]F?|of Funds?)?)",
      bbox: [0, 0, 600, 45],
    },
    clip_bbox: [
      [0, 85, 130, 820],
      [460, 85, 590, 820],
    ],
    line_x: 340.0,
    data: {
      size: [14, 20],
      color: [-16777216],
      update_size: 30.0,
      font: ["Unnamed-T3"],
    },
    content_size: [30.0, 14.0],
    method: "clip",
    line_side: "both",
    max_financial_index_highlight: 4,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    scheme: [
      "Fund\\s*Details?",
      "Benchmark\\s+Name",
      "NAV.*?latest",
      "AUM",
      "AAUM",
      "Name\\s+[Oo]f\\s+Fund\\s+Managers",
      "Minimum Investment",
      "Lump\\s*sum\\s+[Aa]mount",
      "SIP\\s+[Aa]mount",
      "Load Structure",
      "Exit\\s*[Ll]oad:?",
      "Expense Ratio",
      "EOL",
      "Major\\s+Risk\\s+Factors?",
      "EOL",
    ],
    date: "(\\d{2}-?\\s*[A-Za-z]+-?\\s*\\d{2,4})",
    min_amt: "([\\d,]+).*()",
    aum: "\\D+([\\d,.]+\\s*cr)",
    metrics: "(Equity Turnover|Average\\s*Maturity|Macaulay\\s*Duration|Tracking Error\\s*(?:Regular)?|Modified\\s*Duration|YTM\\D*|Yield\\s*[Tt]o\\s*Maturity|Portfolio\\s*Turnover\\s*Ratio|Standard\\s*Deviation|Beta|Sharpe\\s*Ratio|Tracking\\s*Error\\s*Direct|Information\\s*Ratio)\\s*[\\:\\-]?\\s*(\\(?\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?\\s*\\)?\\s*[\\:\\-]?\\s*-?\\d+\\.?\\d+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?)",
    manager: {
      name: "(?:Mrs?|Ms)\\.?\\s+([A-Za-z]+\\s+[A-Za-z]+)",
      exp: "(?<=\\s)\\d{1,2}\\s+[Yy]ears?(?=\\s)",
      since: "[A-Za-z]{3}\\s*\\d{4}",
    },
    escape: "[^A-Za-z0-9\\s\\-\\(\\).,\\+\\%\\:\\&]+|Date of Inception|Allotment|\\(?TRI\\)?|Total\\s*Returns?\\s*Index",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy).*": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(lump_?sum|sip)": ["_extract_amt_data", "min_amt"],
    ".*(major_risk_factors|expense_ratio)$": [
      "_extract_generic_data",
      "metrics",
    ],
    ".*aaum": ["_extract_generic_data", "aum"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "amc_name",
    "main_scheme_name",
    "page_number",
    "monthly_aaum_date",
    "mutual_fund_name",
    "metrics",
    ".*qualitative_data",
    ".*fund_managers?",
    ".*monthly_average_aum",
    "load",
    ".*(exit_load|benchmark|min_investment)",
    ".*(allotment_date|launched)",
  ],
  MERGEKEYS: {
    load: [".*(exit_?load|entry_?load)"],
    metrics: [".*(major_risk_factor|key_statistics|expense_ratio)"],
  },
  CLONEKEYS: {
    benchmark_index: ".*benchmark_name",
    scheme_launch_date: ".*fund_details",
    monthly_aaum: ".*aaum$",
    fund_manager: ".*fund_managers?",
    min_amt: ".*lump_?sum",
    min_addl_amt: ".*sip",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {
    fund_manager: "_update_manager_data",
  },
  Z_MUTUAL_FUND_DATA: {},
}
