{
  AMC_NAME: "Sbi Mutual Fund",
  CLONEKEYS: {
    monthly_aaum: ".*aaum_as_on$",
    fund_manager: ".*fund_manager",
    min_amt: ".*lump_?sum",
    min_addl_amt: ".*sip",
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  IMP_DATA: {
    amc_name: "SBI Funds Management Limited",
    mutual_fund_name: "SBI Mutual Fund",
  },
  MAIN_MAP: {
    map: true,
    select: true,
    special: true,
  },
  MERGEKEYS: {
    load: [".*exit_load", ".*entry_load"],
    metrics: [
      ".*(major_risk_factor|key_statistics|expense_ratio|quantitative_measures?)",
    ],
  },
  PARAMS: {
    clip_bbox: [
      [0, 120, 165, 805],
      [430, 115, 590, 750],
    ],
    content_size: [30, 10],
    data: {
      color: [-16763806, -14206313, -10398813],
      font: ["LucidaSans-Bold"],
      size: [7, 12],
      update_size: 30,
    },
    line_side: "",
    line_x: 165,
    max_financial_index_highlight: 7,
    method: "clip",
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    title: {
      bbox: [114.14, 7.02, 583.87, 61.46],
      ocr: false,
      pattern: "((?:SBI|i\\s*_|S35|Magnum|MAGNUM).*?(?:Fund\\s*(?:\\-?\\s*Investment\\s*Plan|\\-?\\s*Savings\\s*Plan)?|FUND|Index|Saver|ETF|FTF|F[oO]F)\\s*(?:of [Ff]unds?|.*?Aggressive\\s*Plan|.*?Hybrid\\s*Plan|.*?Conservative\\s*Plan)?)",
    },
    update_min_add: false,
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy).*": ["_extract_scheme_data", "scheme"],
  },
  PRE_DATA_SELECT: [],
  PROMOTE_KEYS: {},
  REGEX: {
    aum: "([\\d,.]+)\\s*(?:crores|[cC]r)",
    benchmark: "((?:Nifty|Domestic|Price|CRISIL|BSE).+?(?:TRI|Index|Silver|Gold))",
    escape: "[^a-zA-Z0-9\\.\\,\\+\\(\\)\\s\\%\\/\\:\\&]+",
    metrics: "(Equity\\s+(?:Turnover)?|Average\\s*Maturity|Macaulay\\s*Duration|Tracking Error\\s*(?:Regular)?|Modified\\s*Duration|YTM\\D*|Yield\\s*[Tt]o\\s*Maturity|Portfolio\\s*Turnover\\s*Ratio|Standard\\s*Deviation|Beta|Sharpe\\s*Ratio|Tracking\\s*Error\\s*Direct|Information\\s*Ratio)\\s*[\\:\\-]?\\s*(\\(?\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?\\s*\\)?\\s*[\\:\\-]?\\s*-?\\d+\\.?\\d+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?)",
    manager: {
      name: "(?:Mrs?|Ms)\\.?\\s+([A-Za-z]+\\s+[A-Za-z]+)",
      exp: "(?<=\\s)\\d{1,2}(?=\\s)",
      since: "[A-Za-z]{3}\\s*\\d{1,2}\\,\\s+\\d{4}",
    },
    min_amt: "([\\d,.]+)\\s*& in multiples of\\s*(\\d*)\\s*thereafter",
    scheme: [
      "Investment\\s+Objective",
      "Date\\s+[Oo]f\\s+(?:Inception|Allotment)",
      "Benchmark\\s+Index",
      "NAV",
      "AUM\\s+as\\s+on",
      "AAUM\\s+as\\s+on",
      "Fund\\s+Manager\\s+Details?",
      "Minimum\\s+Investment",
      "Lump\\s+sum\\s+[Aa]mount",
      "SIP\\s+[aA]mount",
      "Load\\s+Structure",
      "Exit\\s+Load",
      "(?:Base)?\\s+Expense\\s+Ratio",
      "EOL",
      "Quantitative\\s+Measures?",
      "EOL",
    ],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(lump_?sum|sip)": ["_extract_amt_data", "min_amt"],
    ".*(major_risk_factors|expense_ratio|quantitative_measures)$": [
      "_extract_generic_data",
      "metrics",
    ],
    ".*aaum_as_on": ["_extract_generic_data", "aum"],
  },
  SELECTKEYS: [
    ".*date_of_inception",
    "monthly_aaum",
    "before.benchmark_index",
    "fund_manager",
    "min_amt",
    "min_addl_amt",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_value",
    "page_number",
    "mutual_fund_name",
    "load",
  ],
  SPECIAL_FUNCTIONS: {
    fund_manager: "_update_manager_data",
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  Z_MUTUAL_FUND_DATA: {},
}
