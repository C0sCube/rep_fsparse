{
  AMC_NAME: "Motilal Oswal Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Motilal Oswal Asset Management Company Limited",
    mutual_fund_name: "Motilal Oswal Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(Motilal.*?(?:Fund\\s*(?:o?O?f Funds?(?:.+?Aggressive|.+?Conservative)?)?|ETF(?:.+? of Funds?)?|FoF))",
      bbox: [0, 0, 585, 65],
    },
    clip_bbox: [
      [1.76, 104.48, 170.33, 814.78],
      [435.49, 208.09, 590.89, 753.3],
    ],
    line_x: 170.0,
    data: {
      size: [7, 14],
      color: [-1],
      update_size: 30.0,
      font: ["Calibri-Bold"],
    },
    content_size: [30.0, 15.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 7,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: ["category"],
    update_min_add: false,
  },
    DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    benchmark: "\\d{1,2}[\\s\\-]+[A-Za-z]+[\\s\\,\\-]+\\d{4}(.+$)",
    min_amt: "([\\d,]+).*?([\\d,]+)",
    date: "(\\d{1,2}[\\s\\-]+[A-Za-z]+[\\s\\,\\-]+\\d{4})",
    aum: "([\\d,.]+)",
    scheme: [
      "Fund\\s+Details?",
      // "Date\\s+[Oo]f\\s+[iI]nception",
      "NAV\\s+(?:[Aa]s\\s+[Oo]n)?",
      "AUM\\s*\\:?(?:as\\s*on)?",
      "AAUM\\s*\\:?(?:as\\s*on)?",
      "Fund\\s+Manager\\s+[Dd]etails",
      "Minimum\\s+[iI]nvestment",
      "Lump\\s*[Ss]um\\s+(?:[Aa]mount)?",
      "(Systematic\\s+[iI]nvestment\\s+[pP]lan|SIP)\\s+(?:Amount)?",
      "Load\\s+Structure\\s+Exit\\s+Load",
      "(?:Base)?\\s*Expense\\s+Ratio:?",
      "EOL",
      "Benchmark\\s+[rR]iskometer",
      "EOL",
    ],
    metrics: "(R2|Equity\\s+Turnover|Gross\\s+(?:Exposure)?\\s+Turnover|Average\\s*Maturity|Macaulay\\s*Duration|Tracking Error\\s*(?:Regular)?|Modified\\s*Duration|YTM\\D*|Yield\\s*[Tt]o\\s*Maturity|Portfolio\\s*Turnover\\s*Ratio|Standard\\s*Deviation\\D*|Beta|Sharpe\\s*Ratio|Tracking\\s*Error\\s*Direct|Information\\s*Ratio\\D*)\\s*[\\:\\-]?\\s*(\\(?\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?\\s*\\)?\\s*[\\:\\-]?\\s*-?\\d+\\.?\\d+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?|[Yy]rs?)?)",
    manager: {
      pattern:"(?:Mrs?|Ms)\\.?\\s+([A-Za-z]+\\s+[A-Za-z]+)\\s+Total\\s+Experience\\s*\\:?\\s*(\\d{1,2}\\+?\\s+[Yy]ears?)\\s+Managing\\s+[Ss]ince\\s*\\:?\\s+(\\d{1,2}\\s+[A-Za-z]+[\\s,]+\\d{4})",
      fields:["name", "since", "exp"],
      name: "(?:Mrs?.|Ms.)\\s+([A-Za-z]+\\s*[A-Za-z]+)",
      exp: "(\\d{1,2}[\\s\\+]+[Yy]ears?)",
      since: "((?:Jan|Feb|Mar|Apri|Jun|Jul|Aug|Sept|Oct|Nove|Dece)[a-z]+\\s+\\d{1,2}\\s*,?.*?\\d{4})",
    },
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:]+|Allotment|\\(?TRI\\)?|Total\\s*Returns?\\s*(?:Name|Index)|Benchmark\\s*Name\\s*:?",
  
  },
  PATTERN_TO_FUNCTION: {
    "(before|dummy|DUMMY).*": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(lump_?sum|sip)": ["_extract_amt_data", "min_amt"],
    ".*(major_risk_factors|expense_ratio|benchmark_riskometer)": [
      "_extract_generic_data",
      "metrics",
    ],
    ".*fund_manager": ["_extract_manager_data", "manager"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "benchmark_index",
    "scheme_launch_date",
    "monthly_aaum",
    "load",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "mutual_fund_name",
    "fund_manager",
    "page_number",
    "min_amt",
    "min_addl_amt",
  ],
  MERGEKEYS: {
    load: [".*(exit_?load|entry_?load)"],
    metrics: [".*(major_risk_factor|benchmark_riskometer|expense_ratio)"],
  },
  CLONEKEYS: {
    benchmark_index: ".*fund_details",
    scheme_launch_date: ".*fund_details",
    monthly_aaum: ".*aaum",
    fund_manager: "before.fund_manager",
    min_amt: ".*lump_?sum(?:_amount)?",
    min_addl_amt: ".*sip(?:_amount)?",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {
    // fund_manager: "_update_manager_data",
    scheme_launch_date: "_update_date_data",
    benchmark_index: "_update_benchmark_data",
  },
  Z_MUTUAL_FUND_DATA: {},
}
