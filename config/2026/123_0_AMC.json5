{
  AMC_NAME: "Monarch Networth Asset Management Pvt Ltd.",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Monarch Networth Asset Management Pvt Ltd.",
    mutual_fund_name: "Monarch Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(?:MONARCH|Monarch).+?(?:FUND|Fund)",
      bbox: [0, 60, 585, 112],
    },
    clip_bbox: [
      [204.82, 125.7, 382.38, 242.62],
      [370.08, 6.15, 588.96, 239.1],
      [0, 270, 240, 830],
    ],
    line_x: 200.0,
    data: {
      size: [3, 9],
      color: [23],
      update_size: 30.0,
      font: ["Ubuntu-Bold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 2,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "([\\d,.]+)",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      "Investment\\s+Objective",
      "Fund\\s+Facts?",
      "Date\\s+[Oo]f\\s+Allotment",
      "Fund\\s+Manager",
      "Benchmark",
      "Plans",
      "Minimum\\s+Investment",
      "Load\\s+Structure",
      "Entry:?",
      "Exit:?",
      "NAV\\s+per\\s+[Uu]nit",
      "EOL",
      "Monthly\\s+Average\\s+AUM",
      "EOL",
      "Monthly\\s+Factsheet",
      "EOL"
    ],
    min_amt: "(Rs.\\s+[\\d,]+).*?(\\d+|any)\\s*thereafter",
    manager: {
      pattern: "([A-Za-z]+\\s+[A-Za-z]+)\\s+\\(?Managing.+?[sS]ince(.+?)\\)?",
      fields: ["name","since",],
    },
    metric: "(Aggregate|Beta|R\\s*Squared|Standard Deviation|Sharpe\\*?|Modif?\\s*i?ed\\s*[dD]uration|(?:Average|Residual)\\s+[mM]aturity\\D*|YTM|Macaulay\\s+[dD]uration|Y?ield to Maturity|Information Ratio|Tracking\\s*Error.+?)\\s*\\:?\\s*(-?[\\d.]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?|NA|Nil)",
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\:]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*minimum_investment": ["_extract_amt_data", "min_amt"],
    ".*(monthly_factsheet)": ["_extract_generic_data", "metric"],
    ".*average_aum": ["_extract_generic_data", "aum"],
    ".*fund_manager": ["_extract_manager_data", "manager"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*of_allotment",
    "before.fund_manager",
    "metrics",
    "before.benchmark$",
    ".*minimum_investment",
    "monthly_average_aum",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "load",
  ],
  MERGEKEYS: {
    load: [".*(exit|entry)"],
    metrics: ["metrics", ".*(investment_strategy|monthly_factsheet)"],
  },
  CLONEKEYS: {
    monthly_average_aum: ".*average_aum",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
