{
  AMC_NAME: "Helios Mutual Fund",
  CLONEKEYS: {},
  DUPLICATE_MUTUAL_FUNDS: {},
  IMP_DATA: {
    amc_name: "Helios Capital Asset Management  (India) Private Limited",
    mutual_fund_name: "Helios Mutual Fund",
  },
  MAIN_MAP: {
    map: true,
    select: true,
    special: true,
  },
  MERGEKEYS: {
    load: [".*entry_load", ".*exit_load"],
    metrics: [
      "metrics",
      "portfolio_turnover_times.total_turnover",
      ".*total_expense_ratio",
    ],
  },
  PARAMS: {
    clip_bbox: [[0, 150, 150, 833.22],[434.61, 152.77, 594.4, 832.34]],
    content_size: [30, 10],
    data: {
      color: [-30],
      font: ["Poppins-SemiBold"],
      size: [7, 10],
      update_size: 30,
    },
    line_side: "left",
    line_x: 245,
    max_financial_index_highlight: 6,
    method: "line",
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    title: {
      bbox: [0, 0, 510, 60],
      ocr: false,
      pattern: "(Helios.*[Ff]und)",
    },
    update_min_add: false,
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy)": ["_extract_scheme_non_esc_data", "scheme"],
  },
  PRE_DATA_SELECT: [],
  PROMOTE_KEYS: {},
  REGEX: {
    benchmark: "((?:Nifty|BSE|CRISIL|Domestic|NYSE).+$)",
    date: "([0-9a-z]+\\s*[A-Za-z]+\\s*\\d{3,4})",
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%]+|\\(Annualised\\)",
    manager: {
      fields: ["name", "since", "exp"],
      pattern: "(?:Mr\\.?|Ms\\.?|Mrs\\.?)?\\s*([\\w\\s]+)(?:\\([^)]+\\))?\\s*\\(Since ([^)]+)\\s*Overall\\s*(\\d+ years)",
    },
    metric: "(Equity Turnover|Total Turnover|Sharpe Ratio|Standard Deviation|Beta|Annualised|Average Maturity|Modi?f?ied Duration|Macaulay Duration|Yield to Maturity)\\s*(-?\\d+\\,?\\.?\\d*\\s*(?:days?|months?|years?|times?)?)",
    min_amt: "([\\d,]+).*?([\\d,]+)",
    ptr: "(Equity Turnover|Total Turnover)\\s*([\\d,.\\-]+)",
    scheme: [
      "Date\\s+[oO]f\\s+Inception",
      "Benchmark\\s+Index",
      "NAV",
      "AUM\\s*\\:?",
      "AAUM\\s*\\:?",
      "Fund\\s+Manager\\s+Details?",
      "Minimum\\s+Investment",
      "Lump\\s+[Ss]um\\s+[aA]mount\\:?",
      "Additional\\s+[iI]nvestment\\s+[aA]mount\\:?",
      "Exit Load\\s*\\:?",
      "Total\\s+Expense\\s+Ratio",
      "EOL",
      "Major\\s+[Rr]isk\\s+Factors?",
      "EOL"
    ],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*benchmark": ["_extract_generic_data", "benchmark"],
    ".*fund_manager$": ["_extract_manager_data", "manager"],
    ".*inception_date": ["_extract_generic_data", "date"],
    ".*investment_amount$": ["_extract_amt_data", "min_amt"],
    ".*total_expense_ratio$": ["_extract_generic_data", "metric"],
  },
  SELECTKEYS: [
    ".*(benchmark|inception_date|fund_manager)$",
    ".*(investment_amount)$",
    "load",
    "main_scheme_name",
    "monthly_aaum_date",
    "amc_name",
    "pgn",
    ".*monthly_avg_aum",
    "metrics",
    "mutual_fund_name",
    "^page_number",
  ],
  SPECIAL_FUNCTIONS: {},
  TERTIARY_PATTERN_TO_FUNCTION: {},
  Z_MUTUAL_FUND_DATA: {},
}
