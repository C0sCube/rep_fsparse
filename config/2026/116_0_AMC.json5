{
  AMC_NAME: "Union Mutual Fund",
  CLONEKEYS: {
    monthly_avg_aum: ".*net_aum",
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  IMP_DATA: {
    amc_name: "Mirae Asset Investment Managers (India) Pvt Ltd.",
    mutual_fund_name: "Platinum SIF",
  },
  MAIN_MAP: {
    map: true,
    select: true,
    special: true,
  },
  MERGEKEYS: {
    load: [".*(entry_load|exit_load)"],
    metrics:[".*net_asset_value"]
  },
  PARAMS: {
    clip_bbox: [[0, 90, 250, 835]],
    content_size: [30, 10],
    data: {
      color: [23],
      font: ["Ubuntu-Bold"],
      size: [6, 9],
      update_size: 30,
    },
    line_side: "",
    line_x: 200,
    max_financial_index_highlight: 5,
    method: "clip",
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    title: {
      bbox: [190, 0, 600, 60],
      ocr: false,
      pattern: "PLATINUM.+?FUND",
    },
    update_min_add: false,
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  PRE_DATA_SELECT: [],
  PROMOTE_KEYS: {},
  REGEX: {
    aum: "([\\d,.]+\\s*[Cc]rores?)",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    date: "([A-Za-z]+\\s*\\d{2}\\,?\\s*\\d{3,4})",
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\:\\&]+",
    manager: {
      fields: ["name"],
      pattern: "(?:Mr|Mrs|Ms)\\.?\\s+([A-Za-z]+\\s*[A-Za-z]+)",
    },
    metric: "(Yield|Aggregate|Beta|R\\s*Squared|Standard Deviation|Sharpe\\*?|Modified\\s+Duration\\D*|Average\\s+Maturity\\D*|Macaulay\\s+Duration\\D*|Y?ield\\s+to\\s+Maturity|Information Ratio|Tracking\\s*Error.+?)\\s*\\:?\\s*(-?[\\d.]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?|NA|Nil)",
    min_amt: "([\\d,]+).*?([\\d,]+)",
    ptr: "(Equity|Aggregate|Tracking Error)\\s*(-?[\\d.]+)",
    scheme: [
      "Investment\\s+[Oo]bjective",
      "Fund\\s+Managers?",
      "Allotment\\s+Date:?",
      "Benchmark:?",
      "Net\\s+AUM",
      "Exit\\s+Load:?",
      "Plan\\s+Available:?",
      "Minimum\\s+Investment\\s+Amount:?",
      "Minimum\\s+[Aa]mount\\s+for\\s+accredited",
      "NET\\s+ASSET\\s+VALUE",
      "EOL",
    ],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    // ".*net_aum": ["_extract_generic_data", "aum"],
    ".*fund_mana": ["_extract_manager_data", "manager"],
    ".*(minimum_application|minimum_investment)": ["_extract_amt_data", "min_amt"],
    ".*net_asset_value":["_extract_generic_data","metric"]
  },
  SELECTKEYS: [
    ".*allotment_date",
    ".*fund_manager",
    ".*benchmark",
    ".*minimum_investment_amount",
    ".*monthly_avg_aum",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "load",
    "metrics"
  ],
  SPECIAL_FUNCTIONS: {},
  TERTIARY_PATTERN_TO_FUNCTION: {},
  Z_MUTUAL_FUND_DATA: {},
}
