{
  AMC_NAME: "Edelweiss Mutual Fund",
  MAIN_MAP: {
    select: true,
    map: true,
    special: true,
  },
  IMP_DATA: {
    amc_name: "Edelweiss Asset Management Limited",
    mutual_fund_name: "Edelweiss Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "((?:Edelweiss|Bharat|BHARAT)\\s*.+?(?:F[Oo]F|Fund\\s*(?:of\\s*[fF]unds?)?|ETF\\s*(?:FOF|Fund\\s*of\\s*Fund)?)\\s*(?:\\-\\s*April\\s*\\d{4})?)",
      bbox: [0.0, 0.0, 400, 90],
    },
    clip_bbox: [
      [0, 50, 530, 150],
      [0, 145, 185, 780],
      [365, 260, 545, 780]
    ],
    line_x: 410.0,
    data: {
      size: [5, 15],
      color: [666],
      update_size: 30.0,
      font: ["Roboto-Bold"],
    },
    content_size: [30.0, 15.0],
    method: "clip",
    line_side: "right",
    max_financial_index_highlight: 5,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    date: "(\\d{1,2}\\s+(?:January|February|March|April|May|June|July|August|September|October|November|December)\\s+\\d{4})",
    benchmark:"\\d{1,2}[A-Za-z\\s]+\\d{4}(.+$)",
    min_amt: "([\\d,]+).*?([\\d,]+)",
    aum: "([\\d,.]+\\s+Cr\\.?)",
    scheme: [
      "Type\\s+[Oo]f\\s+Scheme:?",
      "Product\\s+[lL]abelling:?",
      "Fund\\s+Details?",
      "NAV\\s+[Aa]s\\s+[Oo]n",
      "Date\\s+[Oo]f\\s+Inception",
      "NAV\\s+[Aa]s\\s+[Oo]n",
      "AUM\\s*as\\s*on",
      "AAUM\\s*as\\s*on",
      "Fund\\s+Manager\\s+[Dd]etails",
      "Minimum\\s+[iI]nvestment",
      "Lumpsum",
      "(Systematic\\s+[iI]nvestment\\s+[pP]lan|SIP)",
      "Load\\s+Structure\\s+Exit\\s+Load",
      "(?:Base)?\\s*Expense\\s+Ratio",
      "EOL",
      "Major\\s+Risk\\s+[fF]actors?",
      "EOL",
    ],
   
    offset_metrics: {
      key: "(Tracking Error|Modified Duration|Macaulay Duration|Yield to [Mm]aturity|Average Maturity)",
      value: "(\\d+\\.\\d+(?:%|[Da]ays?|[Mm]onths?|[Yy]ears?)?)",
    },
     metrics: "(Equity\\s+Turnover|Gross.+?Turnover\\D*|Average\\s*Maturity|Macaulay\\s*Duration|Tracking Error\\s*(?:Regular)?|Modified\\s*Duration|YTM\\D*|Yield\\s*[Tt]o\\s*Maturity|Portfolio\\s*Turnover\\s*Ratio|Standard\\s*Deviation|Beta|Sharpe\\s*Ratio|Tracking\\s*Error\\s*Direct|Information\\s*Ratio)\\s*[\\:\\-]?\\s*(\\(?\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?\\s*\\)?\\s*[\\:\\-]?\\s*-?\\d+\\.?\\d+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?)",
    manager: {
      name: "(?:Mrs?|Ms)\\.?\\s+([A-Za-z]+\\s+[A-Za-z]+)",
      exp: "(\\d{1,2})\\s+[Yy]ears",
      since: "\\d{2}\\s+[A-Za-z]+\\s+\\d{4}",
    },
    escape: "[^A-Za-z0-9\\s\\-\\(\\).,\\+\\%\\:\\&]+|Allotment|\\(?TRI\\)?|Total\\s*Returns?\\s*Index",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy).*": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(lumpsum|sip)": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*(major_risk_factors|expense_ratio)$": [
      "_extract_generic_data",
      "metrics",
    ],
     ".*aaum_as_on": ["_extract_generic_data", "aum"],
      ".*date_of_inception": ["_extract_generic_data", "date"],
      ".*fund_details": ["_extract_generic_data", "benchmark"],


  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*type_of_scheme",
    "benchmark_index",
    "scheme_launch_date",
    "monthly_aaum",
    "load",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "mutual_fund_name",
    "fund_manager",
    "page_number",
    "min_amt",
    "min_addl_amt"
  ],
  MERGEKEYS: {
    load: [".*(structure_exit_?load|entry_?load)"],
    metrics: [".*(major_risk_factor|key_statistics|expense_ratio)", ],
  
  },
  CLONEKEYS: {
    benchmark_index: ".*fund_details$",
    scheme_launch_date: ".*date_of_inception$",
    "monthly_aaum":".*aaum_as_on$",
    fund_manager:".*fund_manager_details",
    min_amt:".*lumpsum$",
    min_addl_amt:".*sip$"
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {
    // scheme_launch_date: "_update_date_data",
    // benchmark_index: "_update_benchmark_data",
    fund_manager:"_update_manager_data"
  },
  Z_MUTUAL_FUND_DATA: {},
}
