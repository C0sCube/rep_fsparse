{
  AMC_NAME: "Lic Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "LIC Mutual Fund Asset Management Limited",
    mutual_fund_name: "LIC Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(LIC\\s+MF.+?(?:Fund|Scheme|ETF))",
      bbox: [0, 0, 585, 45],
    },
    clip_bbox: [
      [0, 90, 195, 820],
      [435, 205, 605, 655],
    ],
    line_x: 210.0,
    data: {
      size: [6, 12],
      color: [666],
      update_size: 30.0,
      font: ["Arial-BoldMT"],
    },
    content_size: [30.0, 16.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 7,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "([\\d,.]+\\s*[Cc]rs?)",
    load: "(?:Entry Load)?\\s*(Nil|.*?)\\s*Exit Load\\s*(.*)$",
    min_amt: "([\\d,]+).*?([\\d,]+)",
    scheme: [
      "Fund\\s+Details?",
      "NAV\\s+[Aa]s\\s+[Oo]n",
      "Date\\s+[Oo]f\\s+[iI]nception",
      "Benchmark\\s+[nN]ame",
      "NAV\\s+[Aa]s\\s+[Oo]n",
      "AUM\\s*\\:?(?:as\\s*on)?",
      "AAUM\\s*\\:?(?:as\\s*on)?",
      "Fund\\s+Manager\\s+[Dd]etails",
      "Minimum\\s+[iI]nvestment",
      "Lump\\s+[Ss]um\\s+(?:[Aa]mount)?",
      "(Systematic\\s+[iI]nvestment\\s+[pP]lan|SIP)\\s+(?:Amount)?",
      "Load\\s+Structure\\s+Exit\\s+Load",
      "(?:Base)?\\s*Expense\\s+Ratio",
      "EOL",
      "Benchmark\\s+[rR]iskometer",
      "EOL",
    ],
    metrics: "(R2|Equity\\s+Turnover|Gross\\s+(?:Exposure)?\\s+Turnover|Average\\s*Maturity|Macaulay\\s*Duration|Tracking Error\\s*(?:Regular)?|Modified\\s*Duration|YTM\\D*|Yield\\s*[Tt]o\\s*Maturity|Portfolio\\s*Turnover\\s*Ratio|Standard\\s*Deviation|Beta|Sharpe\\s*Ratio|Tracking\\s*Error\\s*Direct|Information\\s*Ratio\\D*)\\s*[\\:\\-]?\\s*(\\(?\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?\\s*\\)?\\s*[\\:\\-]?\\s*-?\\d+\\.?\\d+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?)",
    manager: {
      name: "(?:Mr.|Mrs.|Ms.|M .)\\s+([A-Za-z]+\\s*[A-Za-z]+)",
      exp: "(\\d+.?\\d*\\+?\\s*years?)",
      since: "((?:Jan|Feb|Mar|Apri|Jun|Jul|Aug|Sept|Oct|Nove|Dece)[a-z]+\\s+\\d{1,2}\\s*,?.*?\\d{4})",
    },
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:]+|Allotment|\\(?TRI\\)?|Total\\s*Returns?\\s*Index",
  },
  PATTERN_TO_FUNCTION: {
    "(before|dummy|DUMMY).*": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(lump_?sum|sip)": ["_extract_amt_data", "min_amt"],
    ".*(major_risk_factors|expense_ratio|benchmark_riskometer)": [
      "_extract_generic_data",
      "metrics",
    ],
    // ".*aaum": ["_extract_generic_data", "aum"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "benchmark_index",
    "scheme_launch_date",
    "monthly_aaum",
    "load",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "mutual_fund_name",
    "fund_manager",
    "page_number",
    "min_amt",
    "min_addl_amt",
  ],
  MERGEKEYS: {
    load: [".*(exit_?load|entry_?load)"],
    metrics: [".*(major_risk_factor|benchmark_riskometer|expense_ratio)"],
  },
  CLONEKEYS: {
    benchmark_index: ".*benchmark_name",
    scheme_launch_date: ".*date_of_inception",
    monthly_aaum: ".*aaum",
    fund_manager: "before.fund_manager",
    min_amt: ".*lump_?sum(?:_amount)?",
    min_addl_amt: ".*sip(?:_amount)?",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {
    fund_manager: "_update_manager_data",
  },
  Z_MUTUAL_FUND_DATA: {},
}
