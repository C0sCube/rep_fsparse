{
  AMC_NAME: "Groww Mutual Fund",
  MAIN_MAP: {
    select: true,
    map: true,
    special: true,
  },
  IMP_DATA: {
    amc_name: "Groww Asset Management Limited",
    mutual_fund_name: "Groww Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(GROWW.*?(?:FUNDS?|Funds?|ETF|PLAN|PATH)\\s*(?:F[oO]F|FUND\\s+OF\\s+FUNDS?|OF\\s+FUNDS?|FUNDS?)?)",
      bbox: [0, 0, 460, 65],
    },
    clip_bbox: [
      [0, 110, 165, 820],
      [430, 325, 585, 800],
    ],
    line_x: 220.0,
    data: {
      size: [6, 10],
      color: [-1],
      update_size: 30.0,
      font: ["NunitoSans7pt-ExtraBold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "left",
    max_financial_index_highlight: 5,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "([\\d,.]+)\\s+Cr",
    date: "(.+)$",
    scheme: [
      "Fund\\s+Details?",
      "Date\\s+[Oo]f\\s+Inception",
      "Benchmark\\s+Index",
      "NAV\\s+[Aa]s\\s+[Oo]n",
      "AUM\\s*as\\s*on",
      "AAUM",
      "Fund\\s+Manager\\s+[Dd]etails",
      "Minimum\\s+[iI]nvestment",
      "Lump\\s+[Ss]um\\s+(?:Amount)?",
      "(Systematic\\s+[iI]nvestment\\s+[pP]lan|SIP)\\s+(?:Amount)?",
      "Load\\s+Structure\\s+Exit\\s+Load",
      "(?:Base)?\\s*Expense\\s+Ratio",
      "EOL",
      "Major\\s+Risk\\s+[fF]actors?",
      "EOL",
    ],
    min_amt: "([\\d,]+).*?([\\d,]+|[Aa]ny)",

    metrics: "(Standard\\s+Duration|Equity\\s+Turnover|Gross\\s+Exposure|Average\\s*Maturity|Macaulay\\s*Duration|Tracking Error\\s*(?:Regular)?|Modified\\s*Duration|YTM\\D*|Yield\\s*[Tt]o\\s*Maturity|Portfolio\\s*Turnover\\s*Ratio|Standard\\s*Deviation|Beta|Sharpe\\s*Ratio|Tracking\\s*Error\\s*Direct|Information\\s*Ratio)\\s*[\\:\\-]?\\s*(\\(?\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?\\s*\\)?\\s*[\\:\\-]?\\s*-?\\d+\\.?\\d+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?)",
    manager: {
      name: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s+([A-Za-z]+\\s+[A-Za-z]+)",
      exp: "(\\d+\\s+[Yy]ears?)",
      since: "([A-Z\\,\\s0-9]+\\s+\\d{3,4}|Inception)",
    },
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:]+|Allotment",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(lump_?sum|sip)": ["_extract_amt_data", "min_amt"],
    ".*(major_risk_factors|expense_ratio)$": [
      "_extract_generic_data",
      "metrics",
    ],
    ".*aaum": ["_extract_generic_data", "aum"],
    ".*date_of_inception": ["_extract_generic_data", "date"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*type_of_scheme",
    "benchmark_index",
    "scheme_launch_date",
    "monthly_aaum",
    "load",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "mutual_fund_name",
    "fund_manager",
    "page_number",
    "min_amt",
    "min_addl_amt",
  ],
  MERGEKEYS: {
    load: [".*(structure_exit_?load|entry_?load)"],
    metrics: [".*(major_risk_factor|key_statistics|expense_ratio)", ],
  },
  CLONEKEYS: {     benchmark_index: ".*benchmark_index$",
    scheme_launch_date: ".*date_of_inception$",
    "monthly_aaum":".*aaum$",
    fund_manager:".*fund_manager_details",
    min_amt:".*lump_?sum",
    min_addl_amt:".*sip"},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: { ".*fund_manager": "_update_manager_data" }, //".*fund_manager": "_update_manager_data"
  Z_MUTUAL_FUND_DATA: {},
}
