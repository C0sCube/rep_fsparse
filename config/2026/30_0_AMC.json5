{
  AMC_NAME: "Ppfas Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "PPFAS Asset Management Private Limited",
    mutual_fund_name: "PPFAS Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(Parag Parikh.*?(?:Fu\\s*n\\s*ds?|ETF|Fo?O?F|Plans?|rune))",
      bbox: [0, 0, 400, 60],
    },
    clip_bbox: [[0, 115, 200, 850],[200, 115, 440, 850],[445, 115, 590, 850]],
    line_x: 210.0,
    data: {
      size: [6, 12],
      color: [-1],
      update_size: 30.0,
      font: ["Arial-BoldMT"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 8,
    pdf_ocr: false,
    sanitize_fund: true,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "([\\d,.]+\\s*Crores)",
    benchmark: "((?:NIFTY|Nifty).+$)",
    scheme: [
      "Fund\\s+Details",
      "NAV\\s*as\\s*on",
      "AUM\\s*as\\s*on",
      "AAUM\\s*as\\s*on",
      "Fund\\s*Manager\\s*Details",
      "Minimum\\s*[Ii]nvestment",
      "Lump\\s*[Ss]um\\s*[aA]mount:?",
      "SIP\\s*[aA]mount:?",
      "Expense\\s*[rR]atio",
      "EOL",
      "Load Structure",
      "Entry\\s*Load:?",
      "Exit\\s*Load:?",
      "EOL",
      "Additional\\s*Information\\s*pertaining",
      "EOL",
      "Scheme\\s*Riskometer",
      "EOL"
    ],
    date: "([A-Za-z]+\\s+\\d{2}\\,?\\s*\\d{4})",
    manager: {
      pattern:"(?:Mr|Mrs?|Ms)\\.?\\s+([A-Za-z]+\\s+[A-Za-z]+).+?Total Experience\\:?\\s+(\\d{1,2}\\+?\\s+[Yy]ears?)\\s+Managing\\s+Since\\:?\\s+((?:Since\\s+)?[iI]nception|[A-Za-z]+\\s+\\d{1,2}\\,?\\s+\\d{4})",
      fields: ["name","exp","since"],
    },
    min_amt: "([\\d.,]+)(\\s*)",
    metrics: "(Information\\s*Ratio|Beta|Standard\\s*Deviation|Sharpe\\s*Ratio|Macaulay\\s*Duration\\D*?|Portfolio\\s*Turnover\\D*?|Avg\\s*maturity\\D*?|Modified\\s*Duration\\D*?|Yield\\s*to\\s*Maturity\\D*?)[\\s\\:]+(-?[\\d.\\s]+\\s*(?:[Tt]imes?|[Dd]ays?|[Mm]onths?|[Yy]ears?|%|[Tt]imes?)?)",
    load: "Entry Load(.+?)Exit Load(.+)$",
    escape: "[^A-Za-z0-9\\s\\-\\(\\).,\\+\\%\\:\\&]+|Date\\s+[Oo]f\\s+Inception|Allotment|Benchmark\\s+Name|\\(?TRI\\)?|Total\\s*Returns?\\s*Index",
  
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy).*": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(quantitative|allocation_of|expense_ratio|scheme_risko|additional_information_pertaining)": [
      "_extract_generic_data",
      "metrics",
    ],
    ".*aaum_as_on": ["_extract_generic_data", "aum"],

    ".*(lump_?sum_amount|sip_amount)": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*fund_manager": ["_extract_manager_data", "manager"],

  },
  TERTIARY_PATTERN_TO_FUNCTION: {
  },
  SELECTKEYS: [
    "benchmark_index",
    "scheme_launch_date",
    "monthly_aaum",
    "load",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "mutual_fund_name",
    "fund_manager",
    "page_number",
    "min_amt",
    "min_addl_amt"
  ],
  MERGEKEYS: {
    load: [".*(exit_?load|entry_?load)"],
    metrics: [".*(additional_information_pertaining|expense_ratio|scheme_risko)", ],

  },
  CLONEKEYS: {
    benchmark_index: ".*fund_details$",
    scheme_launch_date: ".*fund_details$",
    "monthly_aaum":".*aaum_as_on$",
    fund_manager:".*fund_manager",
    min_amt:".*lump_?sum",
    min_addl_amt:".*sip"
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {
    scheme_launch_date: "_update_date_data",
    benchmark_index: "_update_benchmark_data",
  },
  Z_MUTUAL_FUND_DATA: {},
}
