{
  AMC_NAME: "Jio BlackRock Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Jio BlackRock Asset Management Pvt Ltd.",
    mutual_fund_name: "Jio BlackRock Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(Jio\\s*Black\\s*Rock.+?(?:Fund|ETF|F[Oo]F|Index|Path|Duration|Index|Plan)\\s*(?:.+?Growth|F[Oo]F|Fund of Funds?|of Funds?|Fund?)?)",
      bbox: [3.51, 0.88, 481.14, 44.78],
    },
    clip_bbox: [
      [2.63, 93.95, 163.31, 798.98],
      [430.22, 194.04, 585.62, 807.7],
    ],
    line_x: 590.0,
    data: {
      size: [8, 18],
      color: [0],
      update_size: 30.0,
      font: ["Swiss721BT-Bold"],
    },
    content_size: [30.0, 17.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 7,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
 
 REGEX: {
    benchmark: "\\d{1,2}[\\s\\-]+[A-Za-z]+[\\s\\,\\-]+\\d{4}(.+$)",
    min_amt: "([\\d,]+).*?([\\d,]+|any)",
    date: "Direct Plan.+?Growth\\:?\\s+(.+$)",
    aum: "([\\d,.]+\\d+)",
    scheme: [
      "Fund\\s+Details?",
      "Date\\s+[Oo]f\\s+(?:[iI]nception|[Aa]llotment)",
      "Benchmark\\s+(?:Index|Name)",
      "NAV",
      "AUM\\s*\\:?",
      "AAUM\\s*\\:?",
      "Fund\\s+Manager\\s+[Dd]etails",
      "Minimum\\s+[iI]nvestment",
      "Lump\\s*[Ss]um\\s+(?:[Aa]mount)?",
      "(Systematic\\s+[iI]nvestment\\s+[pP]lan|SIP)\\s+(?:Amount)?",
      "Load\\s+Structure\\s+Exit\\s+Load",
      "(?:Base)?\\s*Expense\\s+Ratio",
      "EOL",
      "Benchmark\\s+[rR]iskometer",
      "EOL",
    ],
    metrics: "(R2|Equity\\s+Turnover|Gross\\s+(?:Exposure)?\\s+Turnover|Average\\s*Maturity\\D*|Macaulay\\s*Duration\\D*|Tracking\\s+Error\\s*(?:Regular)?|Modified\\s*Duration\\D*|YTM\\D*|Yield\\s*[Tt]o\\s*Maturity|Portfolio\\s*Turnover\\s*Ratio|Standard\\s*Deviation\\s*(?:\\(\\s*%\\s*\\))?|Beta|Sharpe\\s*Ratio|Tracking\\s*Error\\s*Direct|Information\\s*Ratio\\D*)\\s*[\\:\\-]?\\s*(\\(?\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?\\s*\\)?\\s*[\\:\\-]?\\s*-?\\d+\\.?\\d+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?|[Yy]rs?)?)",
    manager: {
      pattern:"(?:Mrs?|Ms)\\.?\\s+([A-Za-z]+\\s+[A-Za-z]+)\\s+Total\\s+Experience\\s*\\:?\\s*(\\d{1,2}\\+?\\s+[Yy]ears?)\\s+Managing\\s+[Ss]ince\\s*\\:?\\s+((?:January|February|March|April|May|June|July|August|September|October|November|December)\\s+\\d{4})",
      fields: ["name","exp","since"],
    },
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:]+",
  
  },
  PATTERN_TO_FUNCTION: {
    "(before|dummy|DUMMY).*": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(lump_?sum|sip)": ["_extract_amt_data", "min_amt"],
    ".*(major_risk_factors|expense_ratio|benchmark_riskometer)": [
      "_extract_generic_data",
      "metrics",
    ],
    ".*aaum": ["_extract_generic_data", "aum"],
    ".*fund_manager_details":["_extract_manager_data","manager"],
    ".*date_of_":["_extract_generic_data","date"]
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "benchmark_index",
    "scheme_launch_date",
    "monthly_aaum",
    "load",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "mutual_fund_name",
    "fund_manager",
    "page_number",
    "min_amt",
    "min_addl_amt",
  ],
  MERGEKEYS: {
    load: [".*(exit_?load|entry_?load)"],
    metrics: [".*(major_risk_factor|benchmark_riskometer|expense_ratio)"],
  },
  CLONEKEYS: {
    benchmark_index: ".*benchmark_(?:index|name)",
    scheme_launch_date: ".*date_of_(?:allotment|inception)",
    monthly_aaum: ".*aaum",
    fund_manager: ".*fund_manager_details",
    min_amt: ".*lump_?sum(?:_amount)?",
    min_addl_amt: ".*sip(?:_amount)?",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {
    // fund_manager: "_update_manager_data",
    // scheme_launch_date: "_update_date_data",
    // benchmark_index: "_update_benchmark_data",
  },
  Z_MUTUAL_FUND_DATA: {},
}
