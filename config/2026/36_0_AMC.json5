{
  "AMC_NAME": "Shriram Mutual Fund",
  "CLONEKEYS": {
    "benchmark_index": ".*benchmark_name",
    "fund_manager": ".*fund_manager$",
    "min_addl_amt": ".*sip$",
    "min_amt": ".*lumpsum_amount$",
    "monthly_aaum_value": ".*aaum",
    "scheme_launch_date": ".*fund_details"
  },
  "DUPLICATE_MUTUAL_FUNDS": {},
  "IMP_DATA": {
    "amc_name": "Shriram Asset Management Company Limited",
    "mutual_fund_name": "Shriram Mutual fund"
  },
  "MAIN_MAP": {
    "map": true,
    "select": true,
    "special": true
  },
  "MERGEKEYS": {
    "load": [
      ".*(entry_load|exit_load)"
    ],
    "metrics": [
      "metrics",
      ".*(expense_ratio|major_risk_factor)"
    ]
  },
  "PARAMS": {
    "clip_bbox": [
      [
        6.15,
        115.15,
        185.48,
        843.88
      ],
      [
        408.75,
        135.37,
        589.84,
        840.3
      ]
    ],
    "content_size": [
      30,
      10
    ],
    "data": {
      "color": [
        0
      ],
      "font": [
        "Poppins-SemiBold"
      ],
      "size": [
        6,
        12
      ],
      "update_size": 30
    },
    "line_side": "",
    "line_x": 290,
    "max_financial_index_highlight": 4,
    "method": "clip",
    "pdf_ocr": false,
    "sanitize_fund": false,
    "stop_words": [],
    "title": {
      "bbox": [
        0,
        0,
        500,
        75
      ],
      "ocr": false,
      "pattern": "((?:Shriram|SHRIRAM).+?(?:Funds?|FUNDS?|ETF|INDEX|Index)\\s*(?:OF FUNDS?|Fo?O?F|of\\s+[Ff]unds?)?)"
    },
    "update_min_add": false
  },
  "PATTERN_TO_FUNCTION": {
    "^(before|dummy).*": [
      "_extract_scheme_non_esc_data",
      "scheme"
    ]
  },
  "PRE_DATA_SELECT": [],
  "PROMOTE_KEYS": {},
  "REGEX": {
    "aum": "([\\d.]+\\s*[Cc]r)",
    "benchmark": "^.+?(?:Index|TRI)",
    "date": "(\\d{1,2}\\s*(?:th|st|rd|nd)?\\s*[A-Za-z]+\\s*,?\\s*\\d{3,4})",
    "escape": "[^a-zA-Z0-9\\.\\,\\+\\(\\)\\s\\-\\%]+|TRI|\\(Annualised\\)|Date of [iI]nception.+?[aA]llotment",
    "load": "()Exit Load(.+)$",
    "manager": {
      "exp": "(?<=\\s)\\d{1,2}\\s*[Yy]ears?(?=\\s)",
      "name": "(?:Mrs?|Ms)\\.?\\s+([A-Za-z]+\\s+[A-Za-z]+)",
      "since": "[A-Za-z]{3}\\s*\\d{1,2}\\s*\\,?\\s*\\d{4}"
    },
    "metrics": "(PE|Information\\s+Ratio|PB|Average Maturity|Macaul[ea]y\\s*(?:Duration)?|Modified Duration|Modi.+?ed Duration|Yield to Maturity|Standard\\s+Deviation|Sharpe\\s+[rR]atio|Beta|R Squared|Treynor|Jenson|Portfolio Turnover\\D*)\\s*(?:\\:|\\(.+?\\)\\:?)?\\s*(-?[\\d.]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%)?|NA)",
    "min_amt": "Rs\\.?\\s*([\\d,]+)\\D*(\\d+)",
    "ptr": "([\\d.]+)",
    "scheme": [
      "Fund\\s+Details?",
      "Benchmark\\s+Name",
      "NAV.+?as\\s+on",
      "AUM.+?as\\s+on",
      "AAUM.+?for\\s+the",
      "Fund\\s+Manager",
      "Minimum\\s+[Ii]nvestment",
      "Lumpsum\\s+[aA]mount",
      "SIP",
      "Exit\\s+Load",
      "Total\\s+Expense\\s+Ratio",
      "Please refer to the",
      "EOL",
      "Major\\s+Risk\\s+Factors?",
      "EOL"
    ]
  },
  "SECONDARY_PATTERN_TO_FUNCTION": {
    ".*(expense_ratio|major_risk_factor)": [
      "_extract_generic_data",
      "metrics"
    ],
    ".*(lumpsum_amount|sip)": [
      "_extract_amt_data",
      "min_amt"
    ],
    ".*aaum": [
      "_extract_generic_data",
      "aum"
    ]
  },
  "SELECTKEYS": [
    "monthly_aaum_value",
    "monthly_aaum_date",
    "fund_manager",
    "benchmark_index",
    "monthly_aaum_date",
    "mutual_fund_name",
    "amc_name",
    "main_scheme_name",
    "metrics",
    "scheme_launch_date",
    "(min_amt|min_addl_amt)",
    "load",
    "page_number"
  ],
  "SPECIAL_FUNCTIONS": {
    "benchmark_index": "_update_benchmark_data",
    "fund_manager": "_update_manager_data",
    "scheme_launch_date": "_update_date_data"
  },
  "TERTIARY_PATTERN_TO_FUNCTION": {},
  "Z_MUTUAL_FUND_DATA": {}
}