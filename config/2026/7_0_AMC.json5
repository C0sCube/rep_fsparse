{
  AMC_NAME: "PGIM India Asset Management Pvt Ltd.",
  DUPLICATE_MUTUAL_FUNDS: {},
  IMP_DATA: {
    amc_name: "PGIM India Asset Management Pvt Ltd.",
    mutual_fund_name: "PGIM India Mutual Fund",
  },
  MAIN_MAP: {
    map: true,
    select: true,
    special: true,
  },

  PARAMS: {
    clip_bbox: [
      [0, 100, 170, 800],
      [425, 100, 585, 650],
    ],
    content_size: [30, 10],
    data: {
      color: [-1],
      font: ["PrudentialModern-Bold"],
      size: [6, 12],
      update_size: 30,
    },
    line_side: "",
    line_x: 210,
    max_financial_index_highlight: 7,
    method: "clip",
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    title: {
      bbox: [0, 0, 595, 55],
      ocr: false,
      pattern: "(PGIM\\s+INDIA.+?(?:FUND))",
    },
    update_min_add: false,
  },
 REGEX: {
    benchmark: "\\d{1,2}[\\s\\-]+[A-Za-z]+[\\s\\,\\-]+\\d{4}(.+$)",
    min_amt: "([\\d,]+).*?([\\d,]+)",
    date: "Regular Plan.+?((?:Janu|Feb|Mar|Apr|Ma|Jun|Jul|Augu|Sept|Oct|Nove|Dec)?[a-z]+\\s+\\d{1,2}\\,?\\s+\\d{4})",
    aum: "([\\d,.]+\\d+)",
    scheme: [
      "Fund\\s+Details?",
      "Date\\s+[Oo]f\\s+(?:[iI]nception|[Aa]llotment)",
      "Benchmark\\s+Name",
      "NAV\\s+(?:[Aa]s\\s+[Oo]n)?",
      "AUM\\s*\\:?(?:as\\s*on)?",
      "AAUM\\s*\\:?(?:as\\s*on)?",
      "Fund\\s+Manager\\s+[Dd]etails",
      "Minimum\\s+[iI]nvestment",
      "Lump\\s*[Ss]um\\s+(?:[Aa]mount)?",
      "(Systematic\\s+[iI]nvestment\\s+[pP]lan|SIP)\\s+(?:Amount)?",
      "Load\\s+Structure\\s+Exit\\s+Load",
      "(?:Base)?\\s*Expense\\s+Ratio",
      "EOL",
      "Benchmark\\s+[rR]iskometer",
      "EOL",
    ],
    metrics: "(R2|Equity\\s+Turnover|Gross\\s+(?:Exposure)?\\s+Turnover|Average\\s*Maturity\\D*|Macaulay\\s*Duration\\D*|Tracking\\s+Error\\s*(?:Regular)?|Modified\\s*Duration\\D*|YTM\\D*|Yield\\s*[Tt]o\\s*Maturity|Portfolio\\s*Turnover\\s*Ratio|Standard\\s*Deviation\\D*|Beta|Sharpe\\s*Ratio|Tracking\\s*Error\\s*Direct|Information\\s*Ratio\\D*)\\s*[\\:\\-]?\\s*(\\(?\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?\\s*\\)?\\s*[\\:\\-]?\\s*-?\\d+\\.?\\d+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?|[Yy]rs?)?)",
    manager: {
      pattern:"(?:Mrs?|Ms)\\.?\\s+([A-Za-z]+\\s+[A-Za-z]+)\\s+Total\\s+Experience\\s*\\:?\\s*(\\d{1,2}\\+?\\s+[Yy]ears?)\\s+Managing\\s+[Ss]ince\\s*\\:?\\s+(\\d{1,2}\\s+[A-Za-z]+[\\s,]+\\d{4})",
      fields:["name", "since", "exp"],
      name: "(?:Mrs?.|Ms.)\\s+([A-Za-z]+\\s*[A-Za-z]+)",
      exp: "(\\d{1,2}[\\s\\+]+[Yy]ears?)",
      since: "((?:Jan|Feb|Mar|Apri|Jun|Jul|Aug|Sept|Oct|Nove|Dece)[a-z]+\\s+\\d{1,2}\\s*,?.*?\\d{4})",
    },
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:]+",
  
  },
  PATTERN_TO_FUNCTION: {
    "(before|dummy|DUMMY).*": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(lump_?sum|sip)": ["_extract_amt_data", "min_amt"],
    ".*(major_risk_factors|expense_ratio|benchmark_riskometer)": [
      "_extract_generic_data",
      "metrics",
    ],
    ".*aaum": ["_extract_generic_data", "aum"],
     ".*date_of_(?:allotment|inception)": ["_extract_generic_data", "date"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "benchmark_index",
    "scheme_launch_date",
    "monthly_aaum",
    "load",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "mutual_fund_name",
    "fund_manager",
    "page_number",
    "min_amt",
    "min_addl_amt",
  ],
  MERGEKEYS: {
    load: [".*(exit_?load|entry_?load)"],
    metrics: [".*(major_risk_factor|benchmark_riskometer|expense_ratio)"],
  },
  CLONEKEYS: {
    benchmark_index: ".*benchmark_name",
    scheme_launch_date: ".*date_of_(?:allotment|inception)",
    monthly_aaum: ".*aaum",
    fund_manager: "before.fund_manager",
    min_amt: ".*lump_?sum(?:_amount)?",
    min_addl_amt: ".*sip(?:_amount)?",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {
    fund_manager: "_update_manager_data",
    // scheme_launch_date: "_update_date_data",
    // benchmark_index: "_update_benchmark_data",
  },
  Z_MUTUAL_FUND_DATA: {},
}
