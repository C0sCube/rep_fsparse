{
  AMC_NAME: "Mirae Asset Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Mirae Asset Investment Managers (India) Private Limited",
    mutual_fund_name: "Mirae Asset Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(MIRAE\\s*(?:ASSET|Asset)?.*?(?:FUNDS?|ETF\\s*(?:F[Oo]F|-?\\s*GROWTH|-?\\s*IDCW|FUND\\s*OF\\s*FUNDS?)?|F[Oo]F|PLAN|SAVER)\\s*(?:OF\\s*FUNDS?|FUND\\s*OF\\s*FUNDS?|FUND?|FUNDS?)?)",
      bbox: [35, 5, 480, 55],
    },
    clip_bbox: [
      [0, 120, 156, 800],
      [435, 140, 585, 800],
    ],
    line_x: 270.0,
    data: {
      size: [8, 12],
      color: [-1],
      update_size: 30.0,
      font: ["SpoqaHanSans-Bold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 4,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "(\\d+\\,?\\d+\\.\\d+).+$",
    date: "(\\d{1,2}\\s+[A-Za-z]+\\d{4})",
    benchmark: "^.+?[A-Za-z]+\\d{4}\\s+(.+$)",
    manager: {
      pattern: "(?:Mr|Mrs|Ms)\\.?\\s+([A-Za-z]+\\s+[A-Za-z]+)\\s+Total\\s+Experience:?\\s+(\\d+)\\s+[Yy]ears?\\s+Managing\\s+[Ss]ince:?\\s+(\\d{2}\\s+[A-Za-z]+\\s+\\d{4})",
      fields: ["name", "exp", "since"],
    },
    scheme: [
      "Fund\\s*Details",
      // "Date\\s*of\\s*(?:Inception|Allotment)",
      // "Benchmark\\s*(?:[Ii]ndex)?",
      "NAV\\s*\\:?",
      "Net\\s+AUM:?",
      "AAUM:?",
      "Fund\\s*Manager\\s*Details?",
      "Minimum Investment",
      "Lump\\s*sum\\s*[aA]mount",
      "Minimum\\s+[Aa]dditional\\s+[Aa]pplication\\s+[Aa]mount",
      "SIP\\s*[aA]mount",
      "Load\\s*[sS]tructure",
      "Exit\\s*Load\\:?",
      "Expense\\s+Ratio",
      "EOL",
      "Major\\s*Risk\\s*Factors?",
      "EOL",
    ],
    load: "Entry Load\\s*(.+?)\\s*Exit Load\\s*(.+)$",
    metrics: "(Equity Turnover|Average\\s*Maturity|Macaulay\\s*Duration|Tracking Error\\s*(?:Regular)?|Modified\\s*Duration|YTM\\D*|Yield\\s*[Tt]o\\s*Maturity|Portfolio\\s*Turnover\\s*Ratio|Standard\\s*Deviation|Beta|Sharpe\\s*Ratio|Tracking\\s*Error\\s*Direct|Information\\s*Ratio)\\s*[\\:\\-]?\\s*(\\(?\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?\\s*\\)?\\s*[\\:\\-]?\\s*-?\\d+\\.?\\d+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?)",
    min_amt: "([\\d,]+)\\D+(\\d+)",
    escape: "[^A-Za-z0-9\\s\\-\\(\\).,\\+\\%\\:\\&]+|Allotment:?|\\(?TRI\\)?|Total\\s*Returns?\\s*Index|Date\\s+[oO]f\\s+Inception|Benchmark\\s+Name\\s*:?|\\bst\\b|\\b\\nd\\b|\\brd\\b|\\bth\\b",
  },
  PATTERN_TO_FUNCTION: {
    "(?:^before|^dummy).*": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(lump_?sum|application_amount)": ["_extract_amt_data", "min_amt"],
    ".*(major_risk_factor|expense_ratio)": ["_extract_generic_data", "metrics"],
    ".*aaum": ["_extract_generic_data", "aum"],
    ".*fund_manager": ["_extract_manager_data", "manager"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "benchmark_index",
    "scheme_launch_date",
    "monthly_aaum",
    "load",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "mutual_fund_name",
    "fund_manager",
    "page_number",
    "min_amt",
    "min_addl_amt",
  ],
  MERGEKEYS: {
    load: [".*(exit_?load|entry_?load)"],
    metrics: [".*(major_risk_factor|key_statistics|expense_ratio)"],
  },
  CLONEKEYS: {
    benchmark_index: ".*fund_details$",
    scheme_launch_date: ".*fund_details$",
    monthly_aaum: ".*aaum$",
    fund_manager: ".*fund_manager",
    min_amt: ".*lump_?sum",
    min_addl_amt: ".*application_amount",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {
    benchmark_index: "_update_benchmark_data",
    scheme_launch_date: "_update_date_data",
  },
  Z_MUTUAL_FUND_DATA: {},
}
