{
  AMC_NAME: "ASK Asset Management Pvt Ltd.",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "ASK Asset Management Pvt Ltd.",
    mutual_fund_name: "ASK Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(?:Ask|ASK)\\s*.+?(?:FUND|Fund)",
      bbox: [0, 0, 410, 90],
    },
    clip_bbox: [
      [0, 120, 290, 820],
      [295, 125, 590, 820],
    ],
    line_x: 200.0,
    data: {
      size: [3, 9],
      color: [23],
      update_size: 30.0,
      font: ["Ubuntu-Bold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 6,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "([\\d,.]+\\s*[Cc]rores?)",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      "Investment\\s+Objective",
      "Monthly\\s+AUM",
      "Average\\s+AUM\\s+[Ff]or\\s+the\\s+[mM]onth",
      "Date of Allotment",
      "Benchmark",
      "Base\\s+Expense\\s+Ratio",
      "Exit\\s+Load\\s+Structure",
      "Fund\\s+Manager",
      "Investment\\s+Strategy:?",
      "Latest\\s+NAV",
      "Minimum\\s+Investment",
      "For\\s+[Ee]ligible\\s+[Ff]olios?",
      "Lumpsum",
      "SIP",
      "EOL",
    ],
    min_amt: "(Rs.\\s+[\\d,]+).*?(\\d+|any)\\s*thereafter",
    manager: {
      pattern: "([A-Za-z]+\\s+[A-Za-z]+)\\s+\\(Managing.+?Since(.+?)\\).+?(?:Around|Over)\\s+(\\d{1,2}\\s+[Yy]ears?)",
      fields: ["name","since","exp"],
    },
    metric: "(Aggregate|Beta|R\\s*Squared|Standard Deviation|Sharpe\\*?|Modif?\\s*i?ed\\s*Duration|Average\\s+Maturity\\D*|YTM|Macaulay Duration|Y?ield to Maturity|Information Ratio|Tracking\\s*Error.+?)\\s*\\:?\\s*(-?[\\d.]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?|NA|Nil)",
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\:]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(lumpsum|sip)": ["_extract_amt_data", "min_amt"],
    ".*(investment_strategy)": ["_extract_generic_data", "metric"],
    ".*(average_aum)": ["_extract_generic_data", "aum"],
    ".*fund_manager": ["_extract_manager_data", "manager"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*of_allotment",
    "before.fund_manager",
    "metrics",
    "before.benchmark$",
    ".*minimum_investment",
    "monthly_average_aum",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "load",
  ],
  MERGEKEYS: {
    load: [".*exit_load"],
    metrics: ["metrics", ".*(investment_strategy)"],
  },
  CLONEKEYS: {
    monthly_average_aum: ".*average_aum_for",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
