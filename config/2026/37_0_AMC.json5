{
  AMC_NAME: "Sundaram Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Sundaram Asset Management Company Limited",
    mutual_fund_name: "Sundaram Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(Sundaram.+?(?:Funds?|Plan|Path|ETF|F[Oo]F)\\s*\\-?\\s*(?:of Funds?|Funds?|F[Oo]F|Fund of [Ff]unds?)?\\s*(?:Series\\s+[IVXLCDM]+(?:[-\\s,]+[IVXLCDM]+)*)?)",
      bbox: [0, 0, 450, 60],
    },
    clip_bbox: [
      [0, 70, 190, 800],
      [410, 70, 590, 800],
    ],
    line_x: 220.0,
    data: {
      size: [6, 12],
      color: [6969],
      update_size: 30.0,
      font: ["UniversNextforMORNW02-Cn"],
    },
    content_size: [30.0, 12.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 5,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    date: "([A-Za-z]+\\s+\\d{2}\\,?\\s*\\d{4})",
    benchmark: "\\d{4}\\s+(.+$)",
    aum: "([\\d,.]+)\\s+Cr",
    metrics: "(Information\\s*Ratio|Beta|(?:Standard|Std\\.?)?\\s*Deviation|Tracking\\s+Error|Sharpe\\s*Ratio|Macaulay\\s*Duration|Portfolio\\s*Turnover|(?:Avg\\.?|Average)\\s*[Mm]aturity|Modified\\s*Duration|Yield\\s*to\\s*Maturity)[\\D\\s\\:]+(-?[\\d.\\s]+\\s*(?:[Dd]ays?|[Mm]onths?|[Yy]ears?|%|[Tt]imes?)?)",
    scheme: [
      "Fund\\s+Details?",
      "NAV.+?[rR]egular",
      "AUM",
      "AAUM",
      "Name.+?Fund\\s+Managers",
      "Minimum\\s+[iI]nvestment",
      "Lump\\s*[Ss]um",
      "(Systematic\\s+[iI]nvestment\\s+[pP]lan|SIP)\\s*(?:Amount)?",
      "Load\\s+Structure",
      "(?:Base)?\\s*Expense\\s+Ratio",
      "Additional\\s+Information\\s+[Pp]ertaining",
      "EOL",
      "Major\\s+Risk\\s+[fF]actors?",
      "EOL",
    ],
    min_amt: "([\\d,]+).*?([\\d,]+)",
    manager: {
      name: "\u00b7\\s+([A-Za-z]+\\s+[A-Za-z]+)",
      exp: "(?<=\\s)\\d{1,2}\\s+[Yy]ears?(?=\\s)",
      since: "\\d{2}\\s+[A-Za-z]{3}\\s+\\d{4}",
    },
    escape: "[^A-Za-z0-9\\s\\-\\(\\).,\\+\\%\\:\\&|\u00b7]+|Date\\s+[Oo]f\\s+[iI]nception|Allotment|Benchmark|\\(?TRI\\)?|Total\\s*Returns?\\s*Index|Exit\\s+Load",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy).*": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(lump_?sum|sip)": ["_extract_amt_data", "min_amt"],
    ".*(major_risk_factors|expense_ratio)$": [
      "_extract_generic_data",
      "metrics",
    ],
    "before.aaum": ["_extract_generic_data", "aum"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "benchmark_index",
    "scheme_launch_date",
    "monthly_aaum",
    "load",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "mutual_fund_name",
    "fund_manager",
    "page_number",
    "min_amt",
    "min_addl_amt",
  ],
  MERGEKEYS: {
    load: [".*(exit_?load|entry_?load)"],
    metrics: [".*(major_risk_factor|key_statistics|expense_ratio)"],
  },
  CLONEKEYS: {
    benchmark_index: ".*fund_details$",
    scheme_launch_date: ".*fund_details$",
    monthly_aaum: "before.aaum",
    fund_manager: ".*fund_manager",
    min_amt: ".*lump_?sum",
    min_addl_amt: ".*sip",
    exit_load: ".*load_structure",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {
    scheme_launch_date: "_update_date_data",
    benchmark_index: "_update_benchmark_data",
    fund_manager: "_update_manager_data",
  },
  Z_MUTUAL_FUND_DATA: {},
}
