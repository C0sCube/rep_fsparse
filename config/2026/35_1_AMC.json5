{
  AMC_NAME: "Sbi Mutual Fund Passive",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "SBI Funds Management Limited",
    mutual_fund_name: "SBI Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "((?:SBI|i\\s*_|S35|NIFTY|Nifty|NIFTY50|NIFTY100|NSE|CRISIL|GOLD|SILVER|CPSE|BSE).*?(?:Fund\\s*(?:of funds?|.*?Plan)?|ETF|FTF|F[oO]F|FUNDS?)\\s*(?:\\-\\s*IDCW|FUND\\s*OF\\s*FUNDS?)?)",
      bbox: [0, 0, 460, 65],
    },
    clip_bbox: [
      [0, 125, 165, 820],
      [425, 125, 590, 840],
    ],
    line_x: 290.0,
    data: {
      size: [6, 12],
      color: [-1],
      update_size: 30.0,
      font: ["HelveticaNeue-Medium"],
    },
    content_size: [30.0, 10.0],
    method: "line",
    line_side: "both",
    max_financial_index_highlight: 7,
    pdf_ocr: false,
    sanitize_fund: true,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "([\\d,.]+\\s*[Cc]rores?|[Cc]r)",
    benchmark: "((?:Nifty|Domestic|Price|CRISIL|BSE).+?(?:TRI|Index|Silver|Gold))",
    scheme: [
      "Fund\\s+Details?",
      "Date\\s+of\\s+Inception",
      "Benchmark\\s+Index",
      "NAV",
      "AUM\\s*[Aa]s\\s*[Oo]n",
      "AAUM\\s*[Ff]or",
      "Fund\\s+Manager",
      "Minimum\\s+[iI]nvestment",
      "Load\\s+Structure",
      "Exit\\s+Load",
      "(?:Total)?\\s*Expense\\s+Ratio",
      "EOL",
      "Major\\s+Risk\\s+[fF]actors?",
      "EOL",
    ],
    date: "\\d{2}\\s*\\d{2}\\s*\\d{4}",
    min_amt: "([\\d.,]+)\\D*(?:multiples?)\\D*(\\d+)",
    load: "(?:Entry)?(.+)Exit(.+)$",
    metrics: "(Equity\\s+Turnover|Average\\s*Maturity|Macaulay\\s*Duration|Tracking Error\\s*(?:Regular)?|Modified\\s*Duration|YTM\\D*|Yield\\s*[Tt]o\\s*Maturity|Portfolio\\s*Turnover\\s*Ratio|Standard\\s*Deviation|Beta|Sharpe\\s*Ratio|Tracking\\s*Error\\s*Direct|Information\\s*Ratio)\\s*[\\:\\-]?\\s*(\\(?\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?\\s*\\)?\\s*[\\:\\-]?\\s*-?\\d+\\.?\\d+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?)",
    manager: {
      name: "(?:Mrs?|Ms)\\.?\\s+([A-Za-z]+\\s+[A-Za-z]+)",
      exp: "(?<=\\s)\\d{1,2}\\s+[Yy]ears?(?=\\s)",
      since: "[A-Za-z]+\\s+\\d{4}",
    },
    escape: "[^a-zA-Z0-9\\.\\,\\+\\(\\)\\s\\%\\&]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy|DUMMY).*": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*aaum_for.*": ["_extract_generic_data", "aum"],
    ".*(major_risk_factors|expense_ratio)$": [
      "_extract_generic_data",
      "metrics",
    ],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*date_of_inception$",
    ".*aaum_for",
    ".*benchmark_index$",
    "fund_manager",
    ".*load_structure",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_value",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "load",
  ],
  MERGEKEYS: {
    load: [".*(entry_load|exit_load)"],
    fund_manager: [".*fund_manager"],
    metrics: [".*(portfolio_turnover.*|aum_as_on|quantitative_data)"],
  },
  CLONEKEYS: {},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
