{
  AMC_NAME: "The Wealth Company Mutual Fund",
  CLONEKEYS: {},
  DUPLICATE_MUTUAL_FUNDS: {},
  IMP_DATA: {
    amc_name: "Wealth Company Asset Management Holdings Private Limited",
    mutual_fund_name: "Wealth Company Mutual Fund",
  },
  MAIN_MAP: { map: true, select: true, special: true },
  MERGEKEYS: {
    load: [".*(entry_load|exit_load)"],
    metrics: [
      ".*quantitative_indicators",
      ".*quantitative_data",
      ".*total_expense_ratio",
    ],
  },
  PARAMS: {
    clip_bbox: [
      [0, 80, 210, 853.42],
      [214.98, 119.87, 396.09, 789.5],
    ],
    content_size: [30, 17],
    data: {
      color: [0],
      font: ["Swiss721BT-Bold"],
      size: [8, 18],
      update_size: 30,
    },
    line_side: "",
    line_x: 590,
    max_financial_index_highlight: 7,
    method: "clip",
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    title: {
      bbox: [130, 0, 600, 70],
      ocr: false,
      pattern: "(The\\s*Wealth\\s*Company.+?(?:Fund|ETF|F[Oo]F|Index|Path|Duration|Index|Plan)\\s*(?:.+?Growth|F[Oo]F|Fund of Funds?|of Funds?|Fund?)?)",
    },
    update_min_add: false,
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy).*": ["_extract_scheme_data", "scheme"],
  },
  PRE_DATA_SELECT: [],
  PROMOTE_KEYS: {},
  REGEX: {
    aum: "[\\d,.]+\\s*crores?\\s*([\\d,.]+\\s*crores?)",
    date: "([A-Za-z]+\\s*\\d{2}\\,\\s*\\d{4})",
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%]+|\\(For disclaimers refer page no\\.\\s*[0-9]+\\)",
    load: "Entry Load(.*)Exit Load(.*)$",
    manager: {
      fields: ["name", "exp", "since"],
      pattern: "(?:Mr|Ms)?\\.?(.+?)\\s*(?:\\(.+?\\))?\\s*(\\d+ years)\\s*of\\s*[Ee]xperience.+?Managing.+?since\\s*([A-Za-z]+\\s*[0-9]+)",
    },
    metrics: "(Actual Duration|Yield to Maturity|Actual Duration|Macaulay Duration|Yield\\s*to|average maturity|Mod.*?ed Duration|Tracking\\s*Error|Portfolio\\s*Turnover\\s*Ratio)(?:\\(.+?\\))?\\s*\\-?\\:?\\s*((?:\\([Dd]ays?\\)|\\([Mm]onths?\\)|\\([Yy]ears?\\)|%)?\\s*-?\\d+\\.?\\d*\\s*(?:[Dd]ays?|[Mm]onths?|[Yy]ears?|[Cc]rores?|%)?)",
    min_amt: "([\\d,]+).*?(\\d+|any)",
    scheme: [
      "Fund Features",
      "Benchmark",
      "Plans\\s*(?:&|and)\\s*Options",
      "(?:Inception\\s*Date|Date of Allotment)",
      "Minimum Investment",
      "Minimum Additional Purchase",
      "Fund Manager",
      "Entry Load",
      "Exit Load",
      "Face Value",
      "Monthly\\s*[aA]vg\\s*AUM",
      "Month\\s*[Ee]nd\\s*AUM",
      "Base\\s*Expense\\s*Ratio",
      "EOL",
      "Quantitative\\s*Data", "EOL"
    ],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(minimum_additional|minimum_investment)": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*(quantitative_data|total_expense_ratio)": [
      "_extract_generic_data",
      "metrics",
    ],
    ".*fund_manager": ["_extract_manager_data", "manager"],
    ".*load_structure": ["_extract_generic_data", "aum"],
  },
  SELECTKEYS: [
    "load",
    "metrics",
    ".*(minimum_investment|minimum_additional)",
    ".*fund_manager",
    ".*(inception_date|date_of_allotment)$",
    ".*benchmark",
    ".*monthly_avg_aum$",
    "amc_name",
    "main_scheme_name",
    "page_number",
    "monthly_aaum_date",
    "mutual_fund_name",
  ],
  SPECIAL_FUNCTIONS: {},
  TERTIARY_PATTERN_TO_FUNCTION: {},
  Z_MUTUAL_FUND_DATA: {},
}
