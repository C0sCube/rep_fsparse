{
  AMC_NAME: "Bandhan Mutual Fund",
  CLONEKEYS: {
    fund_manager: ".*fund_manager",
    min_amt: ".*minimum_investment$",
    min_addl_amt: ".*sip$",
    scheme_launch_date: ".*fund_details",
    benchmark_index: ".*fund_details$",
    monthly_aaum_value: ".*aaum_as_on$",
    exit_load:".*load_structure"
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  IMP_DATA: {
    amc_name: "Bandhan Asset Management Company Limited",
    mutual_fund_name: "Bandhan Mutual Fund",
  },
  MAIN_MAP: {
    map: true,
    select: true,
    special: true,
  },
  MERGEKEYS: {
    load: ["(entry_load|exit_load)"],
    metrics: ["metrics", ".*(expense_ratio|major_risk_factor)"],
  },
  PARAMS: {
    clip_bbox: [[0,100, 185, 850], [405, 100, 600, 850]],
    content_size: [30, 10],
    data: {
      color: [23],
      font: ["Ubuntu-Bold"],
      size: [6, 9],
      update_size: 30,
    },
    line_side: "",
    line_x: 200,
    max_financial_index_highlight: 9,
    method: "clip",
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    title: {
      bbox: [0, 0, 500, 70],
      ocr: false,
      pattern: "Bandhan.+?(?:Funds?|Path|Saver|ETF|F[oO]F)\\s*(?:of [Ff]unds?.*?Plan|[Ff]und of [Ff]unds?.*?Plan|[Ff]unds?|F[oO]F|.*?Plan)?",
    },
    update_min_add: false,
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  PRE_DATA_SELECT: [],
  PROMOTE_KEYS: {},
  REGEX: {
    aum: "([\\d,.]+\\s*[Cc]rores?)",
    benchmark: "^\\s*\\d{2}\\s+[A-Za-z]+\\s+\\d{4}\\s+(.+)$",
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\:]+|\\(Annualized\\)|TRI|Total Experience|Managing Since|Benchmark\\:?|Date of Inception|Allotment",
    manager: {
      name: "(?:Mrs?|Ms)\\.?\\s+([A-Za-z]+\\s+[A-Za-z]+)",
      exp: "(^$)",
      since: "\\d{2}\\s+[A-Za-z]+\\s+\\d{4}",
    },
    date:"(\\d{2}\\s+[A-Za-z]+\\s+\\d{4})",
    metric: "(Standard\\s*Deviation|Beta|Tracking\\s*Error|Sharpe\\s+Ratio|Information\\s+Ratio|Average\\s+Maturity|Macaulay\\s+Duration|Modified\\s+Duration|Yield\\s+[tT]o\\s+Maturity|Portfolio Turnover[^\\d]*)\\s*\\(?[A-Za-z%]*\\)?\\s*:?[\\s\\-]*([0-9\\.]+|NA)",
    min_amt: "([\\d,]+).*?(\\d+|any)\\s*(?:amount|thereafter)?",
    scheme: [
      "Fund\\s+Details?",
      // "Benchmark",
      "NAV\\s*as\\s*on",
      "AUM\\s*as\\s*on",
      "AAUM\\s*as\\s*on",
      "Fund\\s+Manager\\s+Details?",
      "Minimum\\s+[Ii]nvestment",
      // "Lumpsum\\s+[aA]mount",
      "SIP",
      "Load\\s+[sS]tructure",
      "Expense Ratio",
      "Please refer to the",
      "EOL",
      "Major\\s+Risk\\s+Factors?",
      "EOL",
    ],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*aaum_?as_on": ["_extract_generic_data", "aum"],
    ".*(expense_ratio|major_risk_factor)": ["_extract_generic_data", "metric"],
    ".*(minimum_investment|sip)": ["_extract_amt_data", "min_amt"],
  },
  SELECTKEYS: [
    "fund_manager",
    "benchmark_index",
    "monthly_aaum_date",
    "monthly_aaum_value",
    "mutual_fund_name",
    "amc_name",
    "main_scheme_name",
    "metrics",
    "scheme_launch_date",
    "(min_amt|min_addl_amt)",
    "load",
    "page_number",
  ],
  SPECIAL_FUNCTIONS: {
    fund_manager:"_update_manager_data",
    scheme_launch_date:"_update_date_data",
    benchmark_index:"_update_benchmark_data"
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  Z_MUTUAL_FUND_DATA: {},
}
