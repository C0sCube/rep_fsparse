{
  AMC_NAME: "Mahindra Manulife Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Mahindra Manulife Investment Management Private Limited",
    mutual_fund_name: "Mahindra Manulife Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(Mahindra\\s*Manulife.*?(?:Funds?|ETF|EOF|F[Oo]F|Plan|Path|Saver|Index|Growth)\\s*(?:F[Oo]F|of Funds?|Fund of Funds?|Funds?)?)",
      bbox: [140,5,480,55],
    },
    clip_bbox: [[0, 105, 180, 840],[450, 105, 585, 700]],
    line_x: 200.0,
    data: {
      size: [7, 10],
      color: [-1],
      update_size: 30.0,
      font: ["QuantumRise-Bold", "QuantumRise", "QuantumRise-Semibold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 7,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: ["experience"],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    benchmark: "(?:Nifty|BSE|FTSE|CRISIL|Domestic).+?(?:TRI|Gold|Silver|Index\\s*(?:TRI)?)",
    manager: {
      pattern:"(?:Mr|Mrs|Ms)\\.?\\s+([A-Za-z]+\\s+[A-Za-z]+)\\s+Total\\s+Experience:?\\s+(\\d+)\\s+[Yy]ears?\\s+Managing\\s+[Ss]ince:?\\s+(\\d{2}\\-[A-Za-z]{3}\\-\\d{2})",
      fields: ["name","exp","since"],
    },
    scheme: [
      "Fund\\s*Details",
      "Date\\s*of\\s*(?:Inception|Allotment)",
      "Benchmark\\s*(?:[Ii]ndex)?",
      "NAV\\s*\\:?",
      "Monthly\\s+AUM",
      "Monthly\\s+AAUM",
      "Quarterly\\s+AAUM",
      "Fund\\s*Manager\\s*Details?",
      "Minimum Investment",
      "Lump\\s*sum\\s*[aA]mount",
      "SIP\\s*[aA]mount",
      "Load\\s*[sS]tructure",
      "Exit\\s*Load\\:?",
      "Expense\\s+Ratio",
      "EOL",
      "Major\\s*Risk\\s*Factors?",
      "EOL",
    ],
    aum: "(\\d+\\,?\\d+\\.\\d+).+$",
    load: "Entry Load\\s*(.+?)\\s*Exit Load\\s*(.+)$",
    metrics: "(Equity Turnover|Average\\s*Maturity|Macaulay\\s*Duration|Tracking Error\\s*(?:Regular)?|Modified\\s*Duration|YTM\\D*|Yield\\s*[Tt]o\\s*Maturity|Portfolio\\s*Turnover\\s*Ratio|Standard\\s*Deviation|Beta|Sharpe\\s*Ratio|Tracking\\s*Error\\s*Direct|Information\\s*Ratio)\\s*[\\:\\-]?\\s*(\\(?\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?\\s*\\)?\\s*[\\:\\-]?\\s*-?\\d+\\.?\\d+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?)",
    min_amt: "([\\d,]+)\\D+(\\d+)", 
    escape: "[^A-Za-z0-9\\s\\-\\(\\).,\\+\\%\\:\\&]+|Allotment:?|\\(?TRI\\)?|Total\\s*Returns?\\s*Index",
  },
  PATTERN_TO_FUNCTION: {
     "(?:^before|^dummy).*": ["_extract_scheme_data", "scheme"],
   },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(lump_?sum|sip)": ["_extract_amt_data", "min_amt"],
    ".*(major_risk_factor|expense_ratio)": ["_extract_generic_data", "metrics"],
    ".*monthly_aaum": ["_extract_generic_data", "aum"],
    ".*fund_manager": ["_extract_manager_data", "manager"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "benchmark_index",
    "scheme_launch_date",
    "monthly_aaum",
    "load",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "mutual_fund_name",
    "fund_manager",
    "page_number",
    "min_amt",
    "min_addl_amt",
  ],
  MERGEKEYS: {     load: [".*(exit_?load|entry_?load)"],
    metrics: [".*(major_risk_factor|key_statistics|expense_ratio)"],},
  CLONEKEYS: {
    benchmark_index: ".*benchmark",
    scheme_launch_date: ".*date_of",
    monthly_aaum: ".*monthly_aaum$",
    fund_manager: ".*fund_manager",
    min_amt: ".*lump_?sum",
    min_addl_amt: ".*sip",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {
    // fund_manager: "_update_manager_data",
  },
  Z_MUTUAL_FUND_DATA: {},
}
