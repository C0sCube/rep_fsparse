{
  AMC_NAME: "Apex SIF",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Aditya Birla Sun Life AMC Limited",
    mutual_fund_name: "Apex SIF",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "Name.+?Hybrid.+?Fund",
      bbox: [14.32, 110.62, 577.82, 268],
    },
    clip_bbox: [[20, 110, 575, 495]],
    line_x: 200.0,
    data: {
      size: [6, 9],
      color: [23],
      update_size: 30.0,
      font: ["Ubuntu-Bold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 5,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "([\\d,.]+\\s*[Cc]rores?)",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      "Investment\\s+Objective",
      "NSE\\s+Symbol",
      "Scheme\\s+Details",
      "Fund\\s+Manager",
      "Benchmark",
      "Plans",
      "Exit\\s+[Ll]oad",
      "Subscription\\s+[Ff]requency",
      "Minimum\\s+[Aa]pplication\\s+[Aa]mount",
      "Redemption\\s+[Ff]requency",
      "AAUM",
      "Base\\s+Expense\\s+Ratio",
      "EOL"
    ],
    manager: {
      pattern: "(?:Mr|Ms|Mrs?)\\.?\\s+([A-Za-z]+\\s+[A-Za-z]+)\\s+\\(Since\\s+([A-Za-z]+\\s+[\\s,0-9]+)\\)",
      fields: ["name","since"],
    },
    min_amt: "([\\d,]+).*?([\\d,]+)",
    date: "([A-Za-z]+\\s*\\d{2}\\,?\\s*\\d{3,4})",
    metric: "(Aggregate|Beta|R\\s*Squared|Standard Deviation|Sharpe\\*?|Modified\\s+Duration|Average Maturity|Macaulay\\s+Duration|YTM|Information Ratio|Tracking\\s*Error.+?)\\s*(?:\\:|\\(.+?\\))?\\s*(-?[\\d.]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?|NA|Nil)",
    ptr: "(Equity|Aggregate|Tracking Error)\\s*(-?[\\d.]+)",
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\:\\&]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(dummy.*|before)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(additional_investment|minimum_investment.*)": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*base_expense_ratio": ["_extract_generic_data", "metric"],
    ".*fund_manager": ["_extract_manager_data", "manager"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*date_of_allotment",
    ".*fund_manager",
    "metrics",
    ".*benchmark",
    ".*(additional_investment|minimum_investment)",
    ".*aaum",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "load",
  ],
  MERGEKEYS: {
    load: [".*(entry_load|exit_load)"],
    metrics:["base_expense_ratio"]
  },
  CLONEKEYS: {},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
