{
  AMC_NAME: "Sbi Mutual Fund",
  CLONEKEYS: {
    benchmark_index: ".*benchmark",
    scheme_launch_date: ".*date_of",
    monthly_aaum: ".*aaum_as_on$",
    fund_manager: ".*fund_manager",
    min_amt: ".*lump_?sum",
    min_addl_amt: ".*sip",
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  IMP_DATA: {
    amc_name: "SBI Funds Management Limited",
    mutual_fund_name: "SBI Mutual Fund",
  },
  MAIN_MAP: {
    map: true,
    select: true,
    special: true,
  },
  MERGEKEYS: {
    load: [".*(exit_?load|entry_?load)"],
    metrics: [".*(major_risk_factor|key_statistics|expense_ratio)"],
  },
  PARAMS: {
    clip_bbox: [
      [0, 95, 165, 810],
      [425, 95, 600, 810],
    ],
    content_size: [30, 10],
    data: {
      color: [-16763806, -14206313, -10398813],
      font: ["LucidaSans-Bold"],
      size: [7, 12],
      update_size: 30,
    },
    line_side: "",
    line_x: 165,
    max_financial_index_highlight: 8,
    method: "clip",
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    title: {
      bbox: [0.88, 0.88, 600, 50],
      ocr: false,
      pattern: "((?:SBI).+?(?:FUND|F[Oo]F)(?:.+?PLAN)?)",
    },
    update_min_add: false,
  },
  PATTERN_TO_FUNCTION: {
    "(?:^before|^dummy).*": ["_extract_scheme_data", "scheme"],
  },
  PRE_DATA_SELECT: [],
  PROMOTE_KEYS: {},
  REGEX: {
    aum: "(\\d+\\,?\\d+\\.\\d+).+$",
    date: "(\\d{2}\\/?\\s*\\d{2}\\/?\\s*\\d{4})",
    escape: "[^A-Za-z0-9\\s\\-\\(\\).,\\+\\%\\:\\&]+|\\(?TRI\\)?|Total\\s*Returns?\\s*Index",
    manager: {
      exp: "([0-9]+\\s*[Yy]ears?)",
      name: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s*([A-Za-z.]+\\s*[A-Za-z]+)",
      since: "([A-Z]{1}[a-z]{2}\\s*\\-?\\s*\\d{4})",
    },
    metrics: "(Equity Turnover|Average\\s*Maturity|Macaulay\\s*Duration|Tracking Error\\s*(?:Regular)?|Modified\\s*Duration|YTM\\D*|Yield\\s*[Tt]o\\s*Maturity|Portfolio\\s*Turnover\\s*Ratio|Standard\\s*Deviation|Beta|Sharpe\\s*Ratio|Tracking\\s*Error\\s*Direct|Information\\s*Ratio)\\s*[\\:\\-]?\\s*(\\(?\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?\\s*\\)?\\s*[\\:\\-]?\\s*-?\\d+\\.?\\d+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?)",
    min_amt: "([\\d,]+)\\D+(\\d+)",
    scheme: [
      "Fund\\s*Details",
      "Date\\s*of\\s*(?:Inception|Allotment)",
      "Benchmark\\s*(?:[Ii]ndex)?",
      "NAV\\s*\\:?",
      "AUM\\s*as\\s*on",
      "AAUM\\s*as\\s*on",
      "Fund\\s*Manager\\s*Details?",
      "Minimum Investment",
      "Lump\\s*sum\\s*[aA]mount",
      "SIP\\s*[aA]mount",
      "Load\\s*[sS]tructure",
      "Exit\\s*Load\\:?",
      "Expense\\s+Ratio",
      "EOL",
      "Major\\s*Risk\\s*Factors?",
      "EOL",
    ],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(lump_?sum|sip)": ["_extract_amt_data", "min_amt"],
    ".*(major_risk_factor|expense_ratio)": ["_extract_generic_data", "metrics"],
    ".*aaum_as_on": ["_extract_generic_data", "aum"],
    ".*date_of": ["_extract_generic_data", "date"],
  },
  SELECTKEYS: [
    "benchmark_index",
    "scheme_launch_date",
    "monthly_aaum",
    "load",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "mutual_fund_name",
    "fund_manager",
    "page_number",
    "min_amt",
    "min_addl_amt",
  ],
  SPECIAL_FUNCTIONS: {
    fund_manager: "_update_manager_data",
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  Z_MUTUAL_FUND_DATA: {},
}
