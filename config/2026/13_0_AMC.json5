{
  AMC_NAME: "Hsbc Mutual Fund",
  MAIN_MAP: {
    select: true,
    map: true,
    special: true,
  },
  IMP_DATA: {
    amc_name: "HSBC Asset Management (India) Private Limited",
    mutual_fund_name: "HSBC Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(HSBC.+?(?:FUNDS?|Funds?|ETF|Active|F[oO]F|Index|Plan|Path)\\s*(?:of [Ff]unds?|Fund of [Ff]unds?|F[oO]F|Fund?|FUNDS?)?)",
      bbox: [0, 0, 450, 50],
    },
    clip_bbox: [
      [0, 125, 190, 750],
      [405, 125, 590, 810],
    ],
    line_x: 180.0,
    data: {
      size: [6, 9],
      color: [-1],
      update_size: 30.0,
      font: ["Arial-BoldMT"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 7,
    sanitize_fund: false,
    pdf_ocr: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    scheme: [
      "Fund\\s*Details?",
      "Benchmark\\s+Name",
      "NAV.*?as\\s+on",
      "AUM",
      "AAUM",
      "Name\\s+[Oo]f\\s+Fund\\s+Managers",
      "Minimum Investment",
      "Lump\\s*sum\\s+[Aa]mount",
      "SIP\\s+[Aa]mount",
      "Load Structure",
      "Exit\\s*[Ll]oad:?",
      "Expense Ratio",
      "EOL",
      "Major\\s+Risk\\s+Factors?",
      "EOL",
    ],
    date: "(\\d{2}-?\\s*[A-Za-z]+-?\\s*\\d{2,4})",
    min_amt: "([\\d,]+).*?([\\d,]+)",
    aum: "\\D+([\\d,.]+\\s*cr)",
     metrics: "(Equity Turnover|Average\\s*Maturity|Macaulay\\s*Duration|Tracking Error\\s*(?:Regular)?|Modified\\s*Duration|YTM\\D*|Yield\\s*[Tt]o\\s*Maturity|Portfolio\\s*Turnover\\s*Ratio|Standard\\s*Deviation|Beta|Sharpe\\s*Ratio|Tracking\\s*Error\\s*Direct|Information\\s*Ratio)\\s*[\\:\\-]?\\s*(\\(?\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?\\s*\\)?\\s*[\\:\\-]?\\s*-?\\d+\\.?\\d+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?)",
       manager: {
      name: "(?:Mrs?|Ms)\\.?\\s+([A-Za-z]+\\s+[A-Za-z]+)",
      exp: "(?<=\\s)\\d{1,2}\\s+[Yy]rs?(?=\\s)",
      since: "[A-Za-z]{3}\\s*\\d{1,2}\\,?\\s+\\d{4}",
    },
    escape: "[^A-Za-z0-9\\s\\-\\(\\).,\\+\\%\\:\\&]+|Date of Inception|Allotment|\\(?TRI\\)?|Total\\s*Returns?\\s*Index",
  
  },
  PATTERN_TO_FUNCTION: {
     "^(before|dummy).*": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(lump_?sum|sip)": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*(major_risk_factors|expense_ratio)$": [
      "_extract_generic_data",
      "metrics",
    ],
     ".*aaum": ["_extract_generic_data", "aum"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "benchmark_index",
    "scheme_launch_date",
    "monthly_aaum",
    "load",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "mutual_fund_name",
    "fund_manager",
    "page_number",
    "min_amt",
    "min_addl_amt"
  ],
  MERGEKEYS: {
    load: [".*(exit_?load|entry_?load)"],
    metrics: [".*(major_risk_factor|key_statistics|expense_ratio)", ],
  },
  CLONEKEYS: {
        benchmark_index: ".*benchmark",
    scheme_launch_date: ".*fund_details$",
    "monthly_aaum":".*aaum$",
    fund_manager:".*fund_manager",
    min_amt:".*lump_?sum",
    min_addl_amt:".*sip"
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {
    // scheme_launch_date: "_update_date_data",
    // benchmark_index: "_update_benchmark_data",
    fund_manager:"_update_manager_data"
  },
  Z_MUTUAL_FUND_DATA: {},
}
