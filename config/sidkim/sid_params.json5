          experience: 2,
          name: 0,
          qualification: 1,
        },
        row_count: 4,
        threshold: 1,
      },
      page_zero: {
        bbox: [[0, 310, 255, 520]],
        ocr: false,
      },
      table_data: {
        keywords: [
          "Name of the scheme",
          "Category of the Scheme",
          "Scheme type",
          "Scheme code",
          "Minimum\\s+Application",
          "Minimum\\s+Additional",
          "Plans\\s*(?:and|&)\\s*Options",
          "Benchmark",
        ],
        threshold: 2,
      },
    },
    PATTERN_TO_FUNCTION: {
      "^(name_of|category_of|scheme_type|.*scheme_code|investment_objective).*": [
        "_extract_str_data",
        null,
      ],
