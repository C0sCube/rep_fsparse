      risk_bbox: ["_extract_scheme_data", "scheme2"],
    },
    PROMOTEKEYS: {},
    REGEX: {
      asset: {
        order: "instr|min|max",
        pattern: "(.+?)\\s*(\\d+\\%?)\\s*(\\d+\\%?)\\s*$",
      },
      benchmark: "((?:Nifty|CRISIL|BSE|Domestic).+?(?:Index|TRI|Gold|Silver|Total Return Index))",
      date: "([A-Za-z]+\\s*\\d{1,2}\\.?\\s*\\d{4})",
      escape: "[^A-Za-z0-9\\s\\-_&\\+\\(\\)\\%\\:]+",
