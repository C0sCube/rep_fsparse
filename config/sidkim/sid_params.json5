        name: "((?:Mr\\.?|Mrs\\.?|Ms\\.?)?\\s*[A-Za-z]+\\s*[A-Za-z]+)",
        qualification: "ualifications\\s*(.+)$",
      },
      min_amt: "(?:Lumpsum\\D+)?\\s*(\\d+\\.?\\d*)\\D*?(?:and in multiples)\\D*?(\\d+\\.?\\d*)",
      nfo: "Rs\\.?\\s*\\d+",
      scheme: [
