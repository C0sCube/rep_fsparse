        "Category\\s*[oO]f\\s*(?:the)?\\s*Scheme",
        "Scheme\\s*Code",
        "NFO\\s*[Oo]pen\\s*[Dd]ate",
        "NFO\\s*[Cc]lose\\s*[Dd]ate",
        "Any\\s*[Mm]odification",
        "EOL",
      ],
      scheme2: [
        "suitable for investors who are seeking",
        "Investors should consult",
      ],
    },
    SECONDARY_PATTERN_TO_FUNCTION: {
      ".*(opens_on|closes_on)$": ["_extract_generic_data", "date"],
      "^(.*offer_for_units|new_fund_offer_price.+)$": [
        "_extract_generic_data",
        "nfo",
      ],
      "^(minimum_additional|minimum_application_amount)": [
        "_extract_amt_data",
        "min_amt",
      ],
      "^load_structure": ["_extract_load_data", "load"],
    },
    SELECTKEYS: [
      "amc_name",
